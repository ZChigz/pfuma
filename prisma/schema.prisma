}

model User {
  id                 String      @id @default(cuid())
  schoolId           String
  fullName           String
  email              String
  passwordHash       String
  role               Role        @default(TEACHER)
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())
  // Bumped when the user is deactivated, changes role or school, resets their
  // password, or an ADMIN logs everyone out. A JWT carrying an older value is
  // rejected (lib/auth.ts).
  tokenVersion       Int         @default(0)
  // Bumped on any change to this person's roles, overrides or status, or to the grants of a role they hold. The session is rebuilt when it moves (lib/access).
  permVersion        Int         @default(0)
  // True for accounts created or reset by an admin until the user picks their own password.
  mustChangePassword Boolean     @default(false)
  phone              String?
  title              String?
  // One or more; the database fills it in from "role" for older code that only sets role.
  staffRoles         StaffRole[]
  // Added by an administrator and has not set or changed the first password yet.
  invitePending      Boolean     @default(false)
  invitedAt          DateTime?
  photoUrl           String?
  // The hidden account a Pfuma support person is signed in as, read-only. Never listed or counted.
  isSupport          Boolean     @default(false)
  passwordChangedAt  DateTime?
  // Set at every successful sign-in (lib/auth.ts); null = has not signed in since this was added.
  lastLoginAt        DateTime?

  school School @relation(fields: [schoolId], references: [id])

  recordedPayments    Payment[]           @relation("RecordedPayments")
  verifiedPayments    Payment[]           @relation("VerifiedPayments")
  voidedPayments      Payment[]           @relation("VoidedPayments")
  recordedExpenses    Expense[]           @relation("RecordedExpenses")
  voidedExpenses      Expense[]           @relation("VoidedExpenses")
  requestedExpenses   ExpenseRequest[]    @relation("RequestedExpenses")
  approvedExpenses    ExpenseRequest[]    @relation("ApprovedExpenses")
  rejectedExpenses    ExpenseRequest[]    @relation("RejectedExpenses")
  disbursedExpenses   ExpenseRequest[]    @relation("DisbursedExpenses")
  auditLogs           AuditLog[]
  subjectAssignments  SubjectAssignment[]
  verifiedAssignments SubjectAssignment[] @relation("VerifiedAssignments")
  marks               Mark[]
  markChanges         MarkChange[]
  assetMaintenances   AssetMaintenance[]
  assetDisposals      AssetDisposal[]
  libraryMember       LibraryMember?
  classesTaught       SchoolClass[]
  closedTerms         AcademicTerm[]      @relation("ClosedTerms")

  exchangeRates         ExchangeRate[]
  resetTokens           PasswordResetToken[]     @relation("ResetTokenUser")
  resetTokensCreated    PasswordResetToken[]     @relation("ResetTokenCreator")
  custodianOf           Asset[]                  @relation("AssetCustodian")
  transfersFrom         AssetTransfer[]          @relation("TransferFrom")
  transfersTo           AssetTransfer[]          @relation("TransferTo")
  transfersRecorded     AssetTransfer[]          @relation("TransfersRecorded")
  incomeRecorded        Income[]
  userRoles             UserRole[]
  notifications         Notification[]
  calendarEventsCreated CalendarEvent[]
  classTeacherOf        ClassTeacher[]
  departmentsHeaded     Department[]             @relation("DepartmentHod")
  teachingAssignments   TeacherAssignment[]      @relation("AssignmentTeacher")
  coTeachingAssignments TeacherAssignment[]      @relation("AssignmentCoTeacher")
  timetableSlots        TimetableSlot[]          @relation("SlotTeacher")
  unavailablePeriods    TeacherAvailability[]
  coversAbsent          CoverLesson[]            @relation("CoverAbsent")
  coversTaken           CoverLesson[]            @relation("CoverTeacher")
  rolesAssigned         UserRole[]               @relation("UserRoleAssignedBy")
  permissionOverrides   UserPermissionOverride[] @relation("OverrideSubject")
  overridesCreated      UserPermissionOverride[] @relation("OverrideCreator")
  accessRequests        AccessRequest[]          @relation("AccessRequester")
  accessRequestsDecided AccessRequest[]          @relation("AccessDecider")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([schoolId, lastLoginAt])
}

// ─── Classes ─────────────────────────────────────────────────────────────────

model SchoolClass {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  levelId        String
  stream         String // e.g. "North"; "" for a level with a single class
  capacity       Int      @default(45)
  classTeacherId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // Legacy columns "grade" and "section" remain in the database until the
  // contract migration and are no longer read or written.

  school             School                    @relation(fields: [schoolId], references: [id])
  level              Level                     @relation(fields: [levelId], references: [id])
  classTeacher       User?                     @relation(fields: [classTeacherId], references: [id])
  currentStudents    Student[]                 @relation("CurrentClass")
  movesFrom          ClassMove[]               @relation("ClassMoveFrom")
  movesTo            ClassMove[]               @relation("ClassMoveTo")
  enrollments        Enrollment[]
  assignments        SubjectAssignment[]
  classTeachers      ClassTeacher[]
  teacherAssignments TeacherAssignment[]
  combinationLinks   SubjectCombinationClass[]
  registers          AttendanceRegister[]
  subjectResults     SubjectResult[]
  reportComments     ReportComment[]
  termResultRows     TermResult[]

  @@unique([schoolId, name])
  @@unique([schoolId, levelId, stream])
  @@index([schoolId])
}

// ─── Academic structure ──────────────────────────────────────────────────────

model Level {
  id       String        @id @default(cuid())
  schoolId String
  name     String // "Form 1" … "Form 6"
  order    Int // 1–6: sorting and promotion
  category LevelCategory
  // Switched off when the school does not have this form (e.g. no A Level). Off forms offer no classes.
  active   Boolean       @default(true)

  school           School               @relation(fields: [schoolId], references: [id])
  classes          SchoolClass[]
  feeStructures    FeeStructure[]
  gradeBoundaries  GradeBoundary[]
  intakes          Intake[]
  subjectLevels    SubjectLevel[]
  combinations     SubjectCombination[]
  teachingGroups   TeachingGroup[]
  syllabusTopics   SyllabusTopic[]
  weightingPlans   WeightingPlan[]
  projectTemplates ProjectTemplate[]
  assessments      Assessment[]
  examPeriodLevels ExamPeriodLevel[]
  examPapers       ExamPaper[]

  @@unique([schoolId, name])
  @@unique([schoolId, order])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  school         School         @relation(fields: [schoolId], references: [id])
  terms          AcademicTerm[]
  promotionsFrom PromotionRun[] @relation("PromotionFromYear")
  promotionsTo   PromotionRun[] @relation("PromotionToYear")

  @@unique([schoolId, year])
  @@index([schoolId])
}

// At most one OPEN term per school: enforced in lib/academic/terms.ts and by the
// partial unique index "AcademicTerm_one_open_per_school" (created in SQL;
// Prisma cannot express partial indexes, so keep it when writing migrations).
model AcademicTerm {
  id             String     @id @default(cuid())
  schoolId       String
  academicYearId String
  termNumber     Int // 1–3
  name           String // "Term 1 2026"
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  status         TermStatus @default(PLANNED)
  closedAt       DateTime?
  closedById     String?
  // The date by which teachers hand in their schemes of work (set by the Head).
  schemeDueDate  DateTime?  @db.Date
  createdAt      DateTime   @default(now())

  school             School               @relation(fields: [schoolId], references: [id])
  academicYear       AcademicYear         @relation(fields: [academicYearId], references: [id])
  closedBy           User?                @relation("ClosedTerms", fields: [closedById], references: [id])
  feeStructures      FeeStructure[]
  charges            Charge[]
  subjectAssignments SubjectAssignment[]
  marks              Mark[]
  termResults        TermResult[]
  enrollments        Enrollment[]
  gradeBoundaries    GradeBoundary[]
  classTeachers      ClassTeacher[]
  studentSubjects    StudentSubject[]
  teachingGroups     TeachingGroup[]
  teacherAssignments TeacherAssignment[]
  assignmentSet      AssignmentSet?
  bellSchedules      BellSchedule[]
  timetables         Timetable[]
  registers          AttendanceRegister[]
  schemesOfWork      SchemeOfWork[]
  weightingPlans     WeightingPlan[]
  assessments        Assessment[]
  markSheets         MarkSheet[]
  subjectResults     SubjectResult[]
  reportComments     ReportComment[]
  examDeadline       ExamDeadline?
  examPeriods        ExamPeriod[]
  finCharges         FinCharge[]
  finFeeItems        FinFeeItem[]

  @@unique([academicYearId, termNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

// Class history: exactly one class per student per term.
model Enrollment {
  id        String           @id @default(cuid())
  schoolId  String
  studentId String
  classId   String
  termId    String
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  reason    String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  class   SchoolClass  @relation(fields: [classId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([termId, classId])
}

// ─── Students & guardians ────────────────────────────────────────────────────

model Student {
  id                     String        @id @default(cuid())
  schoolId               String
  admissionNumber        String // STU + admission year + 4-digit sequence
  firstName              String
  surname                String
  fullName               String // firstName + surname, kept for display and search
  gender                 Gender? // required for new students; null for some legacy rows
  dateOfBirth            DateTime?     @db.Date
  birthCertificateNumber String?
  admissionDate          DateTime      @db.Date
  previousSchool         String?
  medicalNotes           String?
  photoUrl               String?
  status                 StudentStatus @default(ACTIVE)
  // Cache of the class in the OPEN term's Enrollment; updated in the same
  // transaction as the Enrollment. Never the source of truth.
  currentClassId         String?
  houseNumber            String?
  suburb                 String?
  city                   String?
  address                String?
  preferredName          String?
  nationality            String?
  homeLanguage           String?
  religion               String?
  entryType              EntryType?
  // Grade 7 units (Form 1) or O Level passes and points (Lower 6).
  entryResults           Json?
  boarding               BoardingType  @default(DAY)
  houseId                String?
  isBeam                 Boolean       @default(false)
  sponsorName            String?
  orphanStatus           OrphanStatus  @default(NONE)
  specialNeeds           Boolean       @default(false)
  specialNeedsNote       String?
  // Legacy plaintext link token. Emptied by migration 20261017000100 and no
  // longer read or written; dropped by the contract migration.
  portalToken            String?       @unique
  // SHA-256 (hex) of the parent-portal link token. The token itself is shown
  // once when generated and never stored.
  portalTokenHash        String?       @unique
  portalTokenCreatedAt   DateTime?
  portalTokenExpiresAt   DateTime?
  // bcrypt hash of the optional 4-digit portal PIN.
  portalPinHash          String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt
  // Legacy columns "grade", "classId", "parentName", "parentPhone", "active",
  // "studentNumber", "enrollmentYear", "guardianRelationship" and
  // "secondGuardianPhone" remain in the database until the contract migration.

  school            School                 @relation(fields: [schoolId], references: [id])
  currentClass      SchoolClass?           @relation("CurrentClass", fields: [currentClassId], references: [id])
  enrollments       Enrollment[]
  guardians         StudentGuardian[]
  charges           Charge[]
  payments          Payment[]
  finCharges        FinCharge[]
  finPayments       FinPayment[]
  marks             Mark[]
  termResults       TermResult[]
  portalViews       PortalAccessLog[]
  libraryMember     LibraryMember?
  house             House?                 @relation(fields: [houseId], references: [id])
  classMoves        ClassMove[]
  documents         StudentDocument[]
  incidents         IncidentStudent[]
  disciplineActions DisciplineAction[]
  medical           MedicalProfile?
  sickBayVisits     SickBayVisit[]
  exits             StudentExit[]
  alumnus           Alumnus?
  application       Application?
  subjectChoices    StudentSubject[]
  teachingGroups    TeachingGroupStudent[]
  attendance        AttendanceEntry[]
  assessmentMarks   AssessmentMark[]
  sheetComments     SheetStudentComment[]
  subjectResults    SubjectResult[]
  reportComments    ReportComment[]
  examAttendance    ExamAttendance[]
  examIncidents     ExamIncident[]
  candidacies       Candidate[]
  boardResults      BoardResult[]

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, birthCertificateNumber])
  @@index([schoolId])
  @@index([schoolId, currentClassId])
  @@index([schoolId, surname, firstName])
  @@index([schoolId, status])
  @@index([schoolId, houseId])
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  fullName   String
  phone      String // +263XXXXXXXXX (legacy rows that could not be normalised keep their original text)
  altPhone   String?
  email      String?
  nationalId String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  students StudentGuardian[]

  @@unique([schoolId, phone])
  @@index([schoolId])
  @@index([schoolId, phone])
}

// One primary guardian per student: at most one is enforced by the partial
// unique index "StudentGuardian_one_primary_per_student" (SQL only); at least
// one is enforced in lib/students/guardians.ts.
model StudentGuardian {
  studentId        String
  guardianId       String
  relationship     GuardianRelationship
  relationshipNote String? // free text when relationship is OTHER
  isPrimary        Boolean              @default(false)
  isFeePayer       Boolean              @default(false)
  canReceiveSms    Boolean              @default(true)
  canCollect       Boolean              @default(false)
  // e.g. "Only collect with mother"; shown in the profile alert strip.
  custodyNote      String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @default(now()) @updatedAt

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
  @@index([guardianId])
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  levelId   String? // null = applies to every level
  termId    String
  label     String
  currency  Currency
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id])
  level  Level?       @relation(fields: [levelId], references: [id])
  term   AcademicTerm @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([termId])
}

model Charge {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  termId    String
  label     String
  currency  Currency
  amount    Decimal  @db.Decimal(14, 2)
  issuedAt  DateTime @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([termId])
}

model Payment {
  id               String        @id @default(cuid())
  schoolId         String
  studentId        String
  currency         Currency
  amount           Decimal       @db.Decimal(14, 2)
  method           PaymentMethod
  reference        String?
  feeLabel         String
  status           PaymentStatus @default(PENDING)
  popUrl           String? // legacy public URL of an old proof of payment
  // Private proof-of-payment upload (UploadThing custom id "pop:<schoolId>:…");
  // served only through short-lived signed URLs.
  popKey           String?
  recordedBy       String
  verifiedBy       String?
  voidedBy         String?
  recordedAt       DateTime      @default(now())
  verifiedAt       DateTime?
  voidedAt         DateTime?
  paidInZig        Boolean       @default(false)
  zigAmountPaid    Decimal?      @db.Decimal(14, 2)
  exchangeRateUsed Decimal?      @db.Decimal(14, 2)
  // The exact rate row used for a ZiG payment.
  exchangeRateId   String?

  school       School        @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  recorder     User          @relation("RecordedPayments", fields: [recordedBy], references: [id])
  verifier     User?         @relation("VerifiedPayments", fields: [verifiedBy], references: [id])
  voider       User?         @relation("VoidedPayments", fields: [voidedBy], references: [id])
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
}

model Expense {
  id         String        @id @default(cuid())
  schoolId   String
  category   String
  currency   Currency
  amount     Decimal       @db.Decimal(14, 2)
  note       String?
  spentOn    DateTime
  recordedBy String
  status     ExpenseStatus @default(ACTIVE)
  voidedBy   String?
  createdAt  DateTime      @default(now())

  expenseRequestId String?         @unique
  expenseRequest   ExpenseRequest? @relation(fields: [expenseRequestId], references: [id])

  school   School @relation(fields: [schoolId], references: [id])
  recorder User   @relation("RecordedExpenses", fields: [recordedBy], references: [id])
  voider   User?  @relation("VoidedExpenses", fields: [voidedBy], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
}

model ExpenseRequest {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id])
  requestNumber  String
  title          String
  type           ExpenseRequestType
  department     String
  justification  String
  currency       Currency
  estimatedTotal Decimal            @db.Decimal(14, 2)
  actualTotal    Decimal?           @db.Decimal(14, 2)

  status RequestStatus @default(DRAFT)

  requestedById String
  requestedBy   User     @relation("RequestedExpenses", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  rejectedById    String?
  rejectedBy      User?     @relation("RejectedExpenses", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  disbursedById    String?
  disbursedBy      User?          @relation("DisbursedExpenses", fields: [disbursedById], references: [id])
  disbursedAt      DateTime?
  disbursementNote String?
  paymentMethod    PaymentMethod?

  items   ExpenseRequestItem[]
  expense Expense?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([requestedById])
}

model ExpenseRequestItem {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id])
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)

  @@index([requestId])
}

model AuditLog {
  id         String      @id @default(cuid())
  schoolId   String
  actorId    String
  action     AuditAction
  entityType String
  entityId   String
  detail     String?
  // Row values before and after a DATA_CREATE / DATA_UPDATE / DATA_DELETE,
  // written by the database trigger "audit_row_change" (secrets removed).
  before     Json?
  after      Json?
  // The part of Pfuma the entry belongs to (system, students, finance ...), filled by the database.
  module     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([schoolId])
  @@index([schoolId, entityType, entityId])
  @@index([schoolId, createdAt])
}

// One row per view of a student's parent-portal page.
model PortalAccessLog {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId, createdAt])
}

// ─── Results ─────────────────────────────────────────────────────────────────

model Subject {
  id            String           @id @default(cuid())
  schoolId      String
  name          String
  code          String
  maxMark       Int              @default(100)
  // Legacy: the type now lives per level in SubjectLevel.
  type          SubjectType      @default(CORE)
  active        Boolean          @default(true)
  // Academics module: the school's own editable list, grouped into departments.
  shortName     String?
  zimsecCode    String?
  cambridgeCode String?
  departmentId  String?
  examBoard     SubjectExamBoard @default(ZIMSEC)
  isPractical   Boolean          @default(false)
  colour        String           @default("#0F766E")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  school             School                   @relation(fields: [schoolId], references: [id])
  department         Department?              @relation(fields: [departmentId], references: [id])
  assignments        SubjectAssignment[]
  marks              Mark[]
  levels             SubjectLevel[]
  combinationItems   SubjectCombinationItem[]
  studentSubjects    StudentSubject[]
  teachingGroups     TeachingGroup[]
  teacherAssignments TeacherAssignment[]
  syllabusTopics     SyllabusTopic[]
  weightingPlans     WeightingPlan[]
  projectTemplates   ProjectTemplate[]
  assessments        Assessment[]
  subjectResults     SubjectResult[]
  examPapers         ExamPaper[]
  boardCodes         BoardSubjectCode[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model SubjectAssignment {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   User         @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id])
  classId   String
  class     SchoolClass  @relation(fields: [classId], references: [id])
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])
  createdAt DateTime     @default(now())

  marksStatus       AssignmentMarkStatus @default(NOT_STARTED)
  marksVerifiedAt   DateTime?
  marksVerifiedById String?
  marksVerifiedBy   User?                @relation("VerifiedAssignments", fields: [marksVerifiedById], references: [id])

  @@unique([subjectId, classId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([teacherId, schoolId])
}

model Mark {
  id              String     @id @default(cuid())
  schoolId        String
  studentId       String
  subjectId       String
  termId          String
  rawMark         Decimal    @db.Decimal(14, 2)
  percentage      Decimal?   @db.Decimal(14, 2)
  letterGrade     String?
  status          MarkStatus @default(DRAFT)
  verifiedAt      DateTime?
  // Set the first time the mark is verified and never cleared: any change after
  // this moment needs a reason and is recorded in MarkChange.
  firstVerifiedAt DateTime?
  // Why the student was absent (status ABSENT), and whether the Head excused it.
  absenceReason   String?
  excused         Boolean    @default(false)
  // The boundary the letter grade came from, copied when the mark is entered and
  // again when the class is published, so later boundary edits never change a
  // published grade.
  gradeMinPercent Decimal?   @db.Decimal(14, 2)
  gradeMaxPercent Decimal?   @db.Decimal(14, 2)
  enteredBy       String
  enteredAt       DateTime   @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  enterer User         @relation(fields: [enteredBy], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])
  changes MarkChange[]

  @@unique([studentId, subjectId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([schoolId, studentId])
}

// History of every change to a mark after it was first verified.
model MarkChange {
  id          String   @id @default(cuid())
  schoolId    String
  markId      String
  oldRawMark  Decimal  @db.Decimal(14, 2)
  newRawMark  Decimal  @db.Decimal(14, 2)
  changedById String
  reason      String
  changedAt   DateTime @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  mark      Mark   @relation(fields: [markId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([schoolId])
  @@index([markId])
}

model TermResult {
  id                 String    @id @default(cuid())
  schoolId           String
  studentId          String
  termId             String
  totalMarks         Decimal   @db.Decimal(14, 2)
  percentage         Decimal   @db.Decimal(14, 2)
  classPosition      Int?
  // Fair ranking (Part 4): how many of the class's subjects the student sat,
  // how many were offered, and how many students were ranked in the class.
  // classPosition is null when the student sat too few subjects to be ranked.
  subjectsSat        Int?
  subjectsOffered    Int?
  rankedOutOf        Int?
  // 4.3: subjects counted (EXEMPT and excused absences left out), their average
  // percentage, and how many reached the school's pass grade. subjectsSat and
  // percentage are older copies of subjectsTaken and averagePercentage.
  subjectsTaken      Int?
  averagePercentage  Decimal?  @db.Decimal(14, 2)
  subjectsPassed     Int?
  // 4.4 / 4.6: students in the class ("Position 2 of 42"), the overall grade as
  // published, and the report-card extras.
  classSize          Int?
  letterGrade        String?
  classTeacherRemark String?
  daysPresent        Int?
  daysAbsent         Int?
  nextTermStartDate  DateTime? @db.Date
  headRemark         String?
  published          Boolean   @default(false)
  publishedAt        DateTime?

  school             School       @relation(fields: [schoolId], references: [id])
  student            Student      @relation(fields: [studentId], references: [id])
  term               AcademicTerm @relation(fields: [termId], references: [id])
  classId            String?
  formPosition       Int?
  formSize           Int?
  fivePassesEngMaths Boolean?
  aLevelPoints       Int?
  previousAverage    Decimal?     @db.Decimal(7, 2)
  timesLate          Int?
  schoolDays         Int?
  conductGrade       String?
  incidentCount      Int?
  reportCardFileKey  String?
  verificationCode   String?      @unique
  calculatedAt       DateTime?
  class              SchoolClass? @relation(fields: [classId], references: [id])

  @@unique([studentId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([schoolId, studentId])
}

// A set of boundaries is all rows sharing the same (levelId, termId). The most
// specific set wins: level + term, then level, then term, then the school-wide set
// (both null). This lets O Level and A Level use different boundaries.
model GradeBoundary {
  id          String         @id @default(cuid())
  schoolId    String
  levelId     String?
  termId      String?
  minPercent  Decimal        @db.Decimal(14, 2)
  maxPercent  Decimal        @db.Decimal(14, 2)
  letterGrade String
  // The scale chosen in Settings, Grading: one for O Level and one for A Level. Such a set has no
  // level or term. A set with category null is the older school-wide set, used when no scale is chosen.
  category    LevelCategory?
  points      Int?
  remark      String?

  school School        @relation(fields: [schoolId], references: [id])
  level  Level?        @relation(fields: [levelId], references: [id])
  term   AcademicTerm? @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([schoolId, levelId, termId])
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model AssetCategory {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school School  @relation(fields: [schoolId], references: [id])
  assets Asset[]

  @@index([schoolId])
}

model Asset {
  id              String         @id @default(cuid())
  schoolId        String
  name            String
  categoryId      String
  description     String?
  tagNumber       String
  acquisitionDate DateTime
  acquisitionCost Decimal        @db.Decimal(14, 2)
  currency        Currency
  location        String
  // Who looks after it: a staff member (custodianId) or, for anyone else, a name.
  custodian       String?
  custodianId     String?
  condition       AssetCondition @default(GOOD)
  status          AssetStatus    @default(ACTIVE)
  imageUrl        String?
  createdAt       DateTime       @default(now())

  school        School             @relation(fields: [schoolId], references: [id])
  category      AssetCategory      @relation(fields: [categoryId], references: [id])
  maintenance   AssetMaintenance[]
  disposal      AssetDisposal?
  custodianUser User?              @relation("AssetCustodian", fields: [custodianId], references: [id])
  transfers     AssetTransfer[]

  @@unique([schoolId, tagNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

// Every change of an asset's location or custodian, kept for good (append-only).
model AssetTransfer {
  id                String   @id @default(cuid())
  schoolId          String
  assetId           String
  fromLocation      String
  toLocation        String
  fromCustodianId   String?
  toCustodianId     String?
  fromCustodianName String?
  toCustodianName   String?
  transferDate      DateTime
  note              String?
  recordedById      String
  createdAt         DateTime @default(now())

  school        School @relation(fields: [schoolId], references: [id])
  asset         Asset  @relation(fields: [assetId], references: [id])
  fromCustodian User?  @relation("TransferFrom", fields: [fromCustodianId], references: [id])
  toCustodian   User?  @relation("TransferTo", fields: [toCustodianId], references: [id])
  recordedBy    User   @relation("TransfersRecorded", fields: [recordedById], references: [id])

  @@index([schoolId])
  @@index([assetId, transferDate])
}

// Money the school receives that is not a student payment (e.g. selling a disposed asset).
// Finance reports add it to the net position.
model Income {
  id              String       @id @default(cuid())
  schoolId        String
  source          IncomeSource
  amount          Decimal      @db.Decimal(14, 2)
  currency        Currency
  receivedOn      DateTime
  description     String
  assetDisposalId String?      @unique
  recordedById    String
  createdAt       DateTime     @default(now())

  school     School         @relation(fields: [schoolId], references: [id])
  disposal   AssetDisposal? @relation(fields: [assetDisposalId], references: [id])
  recordedBy User           @relation(fields: [recordedById], references: [id])

  @@index([schoolId])
  @@index([schoolId, currency])
}

model AssetMaintenance {
  id              String    @id @default(cuid())
  schoolId        String
  assetId         String
  maintenanceDate DateTime
  description     String
  cost            Decimal?  @db.Decimal(14, 2)
  currency        Currency?
  provider        String?
  nextServiceDate DateTime?
  recordedBy      String
  createdAt       DateTime  @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  asset    Asset  @relation(fields: [assetId], references: [id])
  recorder User   @relation(fields: [recordedBy], references: [id])

  @@index([schoolId])
}

model AssetDisposal {
  id           String         @id @default(cuid())
  schoolId     String
  assetId      String         @unique
  disposalDate DateTime
  reason       String
  method       DisposalMethod
  proceeds     Decimal?       @db.Decimal(14, 2)
  currency     Currency?
  recordedBy   String
  createdAt    DateTime       @default(now())

  school   School  @relation(fields: [schoolId], references: [id])
  asset    Asset   @relation(fields: [assetId], references: [id])
  recorder User    @relation(fields: [recordedBy], references: [id])
  income   Income?

  @@index([schoolId])
}

// ─── Library ─────────────────────────────────────────────────────────────────

model Book {
  id                  String   @id @default(cuid())
  schoolId            String
  isbn                String?
  title               String
  author              String
  subject             String?
  publisher           String?
  year                Int?
  shelfLocation       String?
  coverUrl            String?
  // What a student is charged when they lose a copy (Part 2.7 charge).
  replacementCost     Decimal? @db.Decimal(14, 2)
  replacementCurrency Currency @default(USD)
  // Copy counts are not stored: they are counted from BookCopy (lib/library.ts).

  school School     @relation(fields: [schoolId], references: [id])
  copies BookCopy[]

  @@index([schoolId])
}

model BookCopy {
  id              String        @id @default(cuid())
  schoolId        String
  bookId          String
  accessionNumber String
  condition       CopyCondition @default(NEW)
  status          CopyStatus    @default(AVAILABLE)

  school     School      @relation(fields: [schoolId], references: [id])
  book       Book        @relation(fields: [bookId], references: [id])
  borrowings Borrowing[]

  @@unique([schoolId, accessionNumber])
  @@index([schoolId])
}

// Exactly one of userId (STAFF) and studentId (STUDENT) is set — enforced by the
// check constraints "LibraryMember_exactly_one_person" and "LibraryMember_type_matches"
// (SQL only; keep them when writing migrations).
model LibraryMember {
  id                 String     @id @default(cuid())
  schoolId           String
  memberType         MemberType @default(STAFF)
  userId             String?    @unique
  studentId          String?    @unique
  borrowingSuspended Boolean    @default(false)
  suspensionReason   String?

  school     School      @relation(fields: [schoolId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  student    Student?    @relation(fields: [studentId], references: [id])
  borrowings Borrowing[]

  @@index([schoolId])
}

model Borrowing {
  id                String         @id @default(cuid())
  schoolId          String
  copyId            String
  memberId          String
  checkoutDate      DateTime
  dueDate           DateTime
  returnDate        DateTime?
  conditionOnReturn CopyCondition?
  fineAmount        Decimal        @default(0) @db.Decimal(14, 2)
  fineSettled       Boolean        @default(false)
  createdAt         DateTime       @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  copy   BookCopy      @relation(fields: [copyId], references: [id])
  member LibraryMember @relation(fields: [memberId], references: [id])

  @@index([schoolId])
  @@index([schoolId, copyId])
}

// ─── Finance Settings ────────────────────────────────────────────────────────

// Append-only: a correction is a new row (the database refuses UPDATE and DELETE).
// The rate for a date is the latest row whose effectiveFrom is on or before it.
model ExchangeRate {
  id            String     @id @default(cuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  usdToZig      Decimal
  effectiveFrom DateTime   @default(now())
  source        RateSource @default(SCHOOL)
  setBy         String
  user          User       @relation(fields: [setBy], references: [id])
  note          String?
  createdAt     DateTime   @default(now())
  payments      Payment[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([schoolId, effectiveFrom])
}

// ─── Password reset ──────────────────────────────────────────────────────────
// Sessions are JWTs, so the Auth.js Account / Session / VerificationToken tables are gone.
// A staff password reset is a single-use link valid for 30 minutes; only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          String            @id @default(cuid())
  schoolId    String
  userId      String
  tokenHash   String            @unique
  expiresAt   DateTime
  usedAt      DateTime?
  kind        PasswordTokenKind @default(RESET)
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt

  school    School @relation(fields: [schoolId], references: [id])
  user      User   @relation("ResetTokenUser", fields: [userId], references: [id])
  createdBy User   @relation("ResetTokenCreator", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// ─── Dashboard & System ──────────────────────────────────────────────────────

// One row per school. endsAt null = no end date.
model Subscription {
  id           String             @id @default(cuid())
  schoolId     String             @unique
  plan         String             @default("STANDARD")
  status       SubscriptionStatus @default(ACTIVE)
  startsAt     DateTime           @default(now())
  endsAt       DateTime?
  // Most active students the plan allows; null = unlimited.
  studentLimit Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

// Module switches. No row = the module is on. "system" cannot be switched off.
model SchoolModule {
  id                       String    @id @default(cuid())
  schoolId                 String
  module                   String
  enabled                  Boolean   @default(true)
  enabledAt                DateTime?
  // The Pfuma staff member who switched it (a PlatformAdmin id).
  enabledByPlatformAdminId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, module])
  @@index([schoolId])
}

// The roles of a school (OWNER, TEACHER ...). The 13 system roles are created for every school and
// cannot be deleted. Display name and description are what people see.
model RoleDefinition {
  id               String   @id @default(cuid())
  schoolId         String
  key              String
  name             String
  description      String
  isSystem         Boolean  @default(true)
  // A custom role is made by copying a role; this is the one it was copied from (kept when that role is later deleted: null).
  copiedFromRoleId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  school      School           @relation(fields: [schoolId], references: [id])
  copiedFrom  RoleDefinition?  @relation("RoleCopies", fields: [copiedFromRoleId], references: [id], onDelete: SetNull)
  copies      RoleDefinition[] @relation("RoleCopies")
  permissions RolePermission[]
  users       UserRole[]

  @@unique([schoolId, key])
  @@index([schoolId])
  @@index([copiedFromRoleId])
}

// Every permission key there is, module.page.action ("*" means everything). Other modules add
// their keys when they are built. Not per school: it is the catalogue.
model Permission {
  key         String   @id
  module      String
  // The three parts of "module.page.action" kept apart so the grid and the checks need not split the key ("*" has page and action "*").
  page        String
  action      String
  description String
  // Reads of a sensitive key, and every refusal of it, are written to the audit log (lib/access).
  isSensitive Boolean  @default(false)
  createdAt   DateTime @default(now())

  grants    RolePermission[]
  overrides UserPermissionOverride[]
  requests  AccessRequest[]
}

model RolePermission {
  id            String      @id @default(cuid())
  schoolId      String
  roleId        String
  permissionKey String
  // How far the grant reaches. Worked out from records (class teacher, timetable, hostel ...), never typed in: see lib/access/scopes.ts.
  scope         AccessScope @default(SCHOOL)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @default(now()) @updatedAt

  school     School         @relation(fields: [schoolId], references: [id])
  role       RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission     @relation(fields: [permissionKey], references: [key])

  @@unique([roleId, permissionKey])
  @@index([schoolId])
}

// A person holds one or more roles. scopeType / scopeId are for roles that apply to one department,
// class or hostel; they are stored now and used when those screens are built (scopeId is empty for the
// whole school).
model UserRole {
  id           String        @id @default(cuid())
  schoolId     String
  userId       String
  roleId       String
  scopeType    RoleScopeType @default(SCHOOL)
  scopeId      String        @default("")
  // Who gave the role (null for roles made by migrations and imports).
  assignedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  school     School         @relation(fields: [schoolId], references: [id])
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       RoleDefinition @relation(fields: [roleId], references: [id])
  assignedBy User?          @relation("UserRoleAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([schoolId])
  @@index([roleId])
  @@index([assignedById])
}

// How far a grant reaches (docs: Pfuma Access Control, Scopes). CHILDREN is reserved for the parent portal.
enum AccessScope {
  SCHOOL
  DEPARTMENT
  CLASS
  ASSIGNED
  HOSTEL
  STORE
  RECORDED_BY_ME
  SELF
  CHILDREN
}

enum OverrideEffect {
  GRANT
  DENY
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

// An exception for one person: one key at one scope, with a reason and an end date (at most 90 days). A DENY beats every grant.
// Expired and revoked rows stay as history. Nobody may make one for themselves (database check).
model UserPermissionOverride {
  id            String         @id @default(cuid())
  schoolId      String
  userId        String
  permissionKey String
  scope         AccessScope    @default(SCHOOL)
  // The department, class, hostel or store for those scopes; empty otherwise.
  scopeId       String         @default("")
  effect        OverrideEffect
  reason        String
  expiresAt     DateTime
  createdById   String
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())

  school     School         @relation(fields: [schoolId], references: [id])
  user       User           @relation("OverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy  User           @relation("OverrideCreator", fields: [createdById], references: [id])
  permission Permission     @relation(fields: [permissionKey], references: [key])
  request    AccessRequest?

  @@index([schoolId, userId])
  @@index([schoolId, expiresAt])
}

// "Request access" on the access-denied page. The Administrator (the Owner for finance and staff-pay keys) approves it as a time-limited
// override or declines it with a reason.
model AccessRequest {
  id                  String              @id @default(cuid())
  schoolId            String
  userId              String
  permissionKey       String
  // The page the person was trying to open.
  page                String
  reason              String
  status              AccessRequestStatus @default(PENDING)
  decidedById         String?
  decidedAt           DateTime?
  // Why it was declined.
  decisionNote        String?
  resultingOverrideId String?             @unique
  createdAt           DateTime            @default(now())

  school     School                  @relation(fields: [schoolId], references: [id])
  user       User                    @relation("AccessRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy  User?                   @relation("AccessDecider", fields: [decidedById], references: [id])
  permission Permission              @relation(fields: [permissionKey], references: [key])
  override   UserPermissionOverride? @relation(fields: [resultingOverrideId], references: [id], onDelete: SetNull)

  @@index([schoolId, status])
  @@index([userId])
}

model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  title     String
  body      String?
  link      String?
  // What kind of notice it is (WELCOME, ROLES_CHANGED, TERM_OPENS_TOMORROW ...), for filtering and icons.
  type      String    @default("GENERAL")
  // Makes a notice that is sent by a schedule safe to send twice: one per person per key.
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, dedupeKey])
  @@index([schoolId])
  @@index([userId, readAt])
}

model CalendarEvent {
  id               String            @id @default(cuid())
  schoolId         String
  title            String
  kind             CalendarEventKind @default(OTHER)
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  // The description. Dates are school-local calendar days; times are school-local "HH:MM" text.
  notes            String?
  allDay           Boolean           @default(true)
  startTime        String?
  endTime          String?
  location         String?
  repeat           CalendarRepeat    @default(NONE)
  // Last day an occurrence may start on; required when repeat is not NONE.
  repeatUntil      DateTime?         @db.Date
  // Who it is for. Stored now; used by messages later.
  audience         CalendarAudience  @default(ALL_STAFF)
  audienceLevelIds String[]          @default([])
  audienceClassIds String[]          @default([])
  // Set on the preloaded public holidays (e.g. "HEROES_DAY:2026") so they are loaded once.
  autoKey          String?
  createdById      String
  createdAt        DateTime          @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@unique([schoolId, autoKey])
  @@index([schoolId, startDate])
}

// One row per school and year once that year's public holidays have been preloaded, so a
// holiday an administrator deletes is not put back.
model CalendarHolidayYear {
  id       String   @id @default(cuid())
  schoolId String
  year     Int
  loadedAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, year])
}

// The streams a school uses (North, South, East ...). Classes take their stream from this list.
model Stream {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, name])
  @@index([schoolId])
}

// ─── Pfuma platform (staff who run the product, not a school) ────────────────

model Plan {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  description         String   @default("")
  // Module keys the plan includes.
  modules             String[]
  defaultStudentLimit Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  schools School[]
}

// Pfuma staff. They have their own sign-in at /platform and no school; school data is never edited by them.
model PlatformAdmin {
  id           String    @id @default(cuid())
  email        String    @unique
  fullName     String
  passwordHash String
  active       Boolean   @default(true)
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs PlatformAuditLog[]
}

// Everything done in the console. Append only.
model PlatformAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  schoolId   String?
  entityType String
  entityId   String
  detail     String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin PlatformAdmin @relation(fields: [adminId], references: [id])

  @@index([createdAt])
  @@index([schoolId])
}

// What Pfuma bills a school. Created and marked paid in the console; the school sees its own.
model SubscriptionInvoice {
  id               String        @id @default(cuid())
  schoolId         String
  number           String        @unique
  issuedOn         DateTime      @db.Date
  dueOn            DateTime?     @db.Date
  amount           Decimal       @db.Decimal(14, 2)
  currency         Currency      @default(USD)
  description      String
  status           InvoiceStatus @default(OPEN)
  paidOn           DateTime?     @db.Date
  createdByAdminId String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId])
}

// ─── Student Information module ──────────────────────────────────────────────
// Columns named *ById / *By point at a User of the same school. They carry no
// Prisma relation (the database trigger check_same_school keeps them in-school),
// so the User model does not grow a back-relation for each of them.

model House {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  colour    String   @default("#6B7280")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school   School    @relation(fields: [schoolId], references: [id])
  students Student[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// A request to put a student in another class. After the open term has started
// it waits for approval (students.enrolment.approve); the approver is recorded.
model ClassMove {
  id            String          @id @default(cuid())
  schoolId      String
  studentId     String
  fromClassId   String?
  toClassId     String
  termId        String?
  effectiveDate DateTime        @db.Date
  reason        ClassMoveReason
  reasonNote    String?
  status        ApprovalState   @default(PENDING)
  requestedById String
  approvedById  String?
  decidedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  from    SchoolClass? @relation("ClassMoveFrom", fields: [fromClassId], references: [id])
  to      SchoolClass  @relation("ClassMoveTo", fields: [toClassId], references: [id])

  @@index([schoolId, status])
  @@index([studentId])
}

// A year-end promotion saved as a draft; nothing changes until it is CONFIRMED.
model PromotionRun {
  id           String             @id @default(cuid())
  schoolId     String
  fromYearId   String
  toYearId     String
  status       PromotionRunStatus @default(DRAFT)
  // One entry per student: { studentId, fromClassId, outcome, toClassId, note }.
  lines        Json
  summary      Json?
  createdById  String
  approvedById String?
  confirmedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  school   School       @relation(fields: [schoolId], references: [id])
  fromYear AcademicYear @relation("PromotionFromYear", fields: [fromYearId], references: [id])
  toYear   AcademicYear @relation("PromotionToYear", fields: [toYearId], references: [id])

  @@index([schoolId, status])
}

model Intake {
  id                String    @id @default(cuid())
  schoolId          String
  name              String // "Form 1, 2027"
  levelId           String
  year              Int
  places            Int
  applicationOpens  DateTime? @db.Date
  applicationCloses DateTime? @db.Date
  testDate          DateTime? @db.Date
  reportingDate     DateTime? @db.Date
  // What the applicant must bring on the reporting day; printed on the offer letter.
  requirements      String[]  @default([])
  applicationFee    Decimal   @default(0) @db.Decimal(14, 2)
  feeCurrency       Currency  @default(USD)
  closed            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  school       School        @relation(fields: [schoolId], references: [id])
  level        Level         @relation(fields: [levelId], references: [id])
  applications Application[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Application {
  id                     String               @id @default(cuid())
  schoolId               String
  intakeId               String
  firstName              String
  surname                String
  gender                 Gender
  dateOfBirth            DateTime             @db.Date
  birthCertificateNumber String?
  previousSchool         String?
  boarding               BoardingType         @default(DAY)
  guardianName           String
  guardianRelationship   GuardianRelationship @default(GUARDIAN)
  guardianPhone          String
  guardianPhone2         String?
  guardianEmail          String?
  address                String?
  entryResults           Json?
  testScore              Decimal?             @db.Decimal(6, 2)
  interviewNotes         String?
  stage                  ApplicationStage     @default(APPLIED)
  // Array of { stage, at, byId, note }: every move, newest last.
  stageHistory           Json                 @default("[]")
  targetClassId          String?
  offerApprovedById      String?
  offerApprovedAt        DateTime?
  offerReference         String?
  acceptedAt             DateTime?
  depositPaid            Boolean?
  studentId              String?              @unique
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @default(now()) @updatedAt

  school    School            @relation(fields: [schoolId], references: [id])
  intake    Intake            @relation(fields: [intakeId], references: [id])
  student   Student?          @relation(fields: [studentId], references: [id])
  documents StudentDocument[]

  @@index([schoolId, intakeId, stage])
}

// Uploads and generated letters. fileKey points at private storage and is only
// ever opened through a signed link that expires after 10 minutes.
model StudentDocument {
  id            String       @id @default(cuid())
  schoolId      String
  studentId     String?
  applicationId String?
  type          DocumentType
  title         String
  fileKey       String?
  mimeType      String?
  sizeBytes     Int?
  date          DateTime?    @db.Date
  expiryDate    DateTime?    @db.Date
  notes         String?
  generated     Boolean      @default(false)
  referenceNo   String?
  // What a generated letter said when it was made, so a copy can be printed and checked later.
  snapshot      Json?
  uploadedById  String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  school      School       @relation(fields: [schoolId], references: [id])
  student     Student?     @relation(fields: [studentId], references: [id])
  application Application? @relation(fields: [applicationId], references: [id])

  @@unique([schoolId, referenceNo])
  @@index([schoolId, studentId])
}

model DisciplineIncident {
  id           String           @id @default(cuid())
  schoolId     String
  occurredAt   DateTime
  location     IncidentLocation
  category     IncidentCategory
  severity     IncidentSeverity
  description  String
  witnesses    String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  school   School             @relation(fields: [schoolId], references: [id])
  students IncidentStudent[]
  actions  DisciplineAction[]

  @@index([schoolId, occurredAt])
}

model IncidentStudent {
  id         String   @id @default(cuid())
  schoolId   String
  incidentId String
  studentId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school   School             @relation(fields: [schoolId], references: [id])
  incident DisciplineIncident @relation(fields: [incidentId], references: [id])
  student  Student            @relation(fields: [studentId], references: [id])

  @@unique([incidentId, studentId])
  @@index([schoolId, studentId])
}

model DisciplineAction {
  id               String                 @id @default(cuid())
  schoolId         String
  incidentId       String
  studentId        String
  type             DisciplineActionType
  status           DisciplineActionStatus @default(RECORDED)
  // Suspension: the status Suspended applies from startDate to endDate and ends by itself.
  startDate        DateTime?              @db.Date
  endDate          DateTime?              @db.Date
  notes            String?
  requestedById    String
  approvedById     String?
  decidedAt        DateTime?
  // Expulsion recommendation: the decision and the ministry / authority reference.
  decision         String?
  decisionDate     DateTime?              @db.Date
  authorityRef     String?
  // Guardian meeting.
  meetingDate      DateTime?              @db.Date
  meetingAttendees String?
  meetingOutcome   String?
  meetingLetterKey String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @default(now()) @updatedAt

  school   School             @relation(fields: [schoolId], references: [id])
  incident DisciplineIncident @relation(fields: [incidentId], references: [id])
  student  Student            @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId])
  @@index([schoolId, type, status])
}

// The most sensitive data in the system. Every view writes MEDICAL_VIEWED.
model MedicalProfile {
  id                        String    @id @default(cuid())
  schoolId                  String
  studentId                 String    @unique
  // [{ name, note? }] from the fixed list (Asthma, Epilepsy, Diabetes, Sickle cell, Heart condition, Other).
  conditions                Json      @default("[]")
  // [{ name, severity: MILD | SEVERE }]. Severe ones show in the profile alert strip.
  allergies                 Json      @default("[]")
  hasSevereAllergy          Boolean   @default(false)
  bloodGroup                String?
  medicalAidProvider        String?
  medicalAidNumber          String?
  medicalAidMainMember      String?
  doctorName                String?
  doctorPhone               String?
  emergencyName             String?
  emergencyPhone            String?
  emergencyRelationship     String?
  specialNeedsType          String?
  supportNeeded             String?
  consentEmergencyTreatment Boolean?
  consentDate               DateTime? @db.Date
  consentFormKey            String?
  notes                     String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @default(now()) @updatedAt

  school      School            @relation(fields: [schoolId], references: [id])
  student     Student           @relation(fields: [studentId], references: [id])
  medications MedicationEntry[]

  @@index([schoolId])
}

model MedicationEntry {
  id        String           @id @default(cuid())
  schoolId  String
  profileId String
  name      String
  dose      String?
  whenGiven String?
  keptBy    MedicationKeeper @default(STUDENT)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  school  School         @relation(fields: [schoolId], references: [id])
  profile MedicalProfile @relation(fields: [profileId], references: [id])

  @@index([schoolId, profileId])
}

model SickBayVisit {
  id               String         @id @default(cuid())
  schoolId         String
  studentId        String
  visitedAt        DateTime
  complaint        String
  treatment        String?
  outcome          SickBayOutcome
  guardianInformed Boolean        @default(false)
  recordedById     String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId])
}

// One per leaving. A student who rejoins and leaves again gets a second row.
model StudentExit {
  id                  String         @id @default(cuid())
  schoolId            String
  studentId           String
  reason              ExitReason
  reasonNote          String?
  state               ExitState      @default(STARTED)
  lastDay             DateTime       @db.Date
  destinationSchool   String?
  destinationDistrict String?
  // [{ key, label, clear, detail, ticked }]: filled by the modules that are on, ticked by hand otherwise.
  clearance           Json           @default("[]")
  // The Head may approve a leaving with items outstanding, and says why.
  overrideReason      String?
  startedById         String
  approvedById        String?
  approvedAt          DateTime?
  completedAt         DateTime?
  // The status the student ended in and the class they left from, kept for the leavers list.
  resultingStatus     StudentStatus?
  lastClassId         String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @default(now()) @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId, studentId])
  @@index([schoolId, state])
}

model Alumnus {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String   @unique
  yearLeft    Int
  lastClass   String?
  phone       String?
  email       String?
  destination String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId, yearLeft])
}

// ─── Academics ───────────────────────────────────────────────────────────────
// Classes, subjects, teacher assignments, attendance, timetable, schemes of work and analytics.
// Everything academic belongs to a term (termId); a student's class always comes from the Enrollment of that
// term. Migration 20261101000000_academics_module adds these tables, with row-level security, the audit trigger and
// the rules the database can keep by itself (clash indexes, checks).

enum SubjectExamBoard {
  ZIMSEC
  CAMBRIDGE
  SCHOOL
}

enum StudentSubjectSource {
  CORE
  CHOSEN
  COMBINATION
}

// An assignment that was replaced or stopped mid-term is ENDED; its marks and registers keep its teacher.
enum AssignmentStatus {
  ACTIVE
  ENDED
}

// The state of the whole set of teacher assignments of a term.
enum SetStatus {
  DRAFT
  PENDING
  APPROVED
  RETURNED
}

enum PeriodType {
  LESSON
  BREAK
  ASSEMBLY
  SPORTS
}

enum RoomType {
  CLASSROOM
  LABORATORY
  COMPUTER_LAB
  WORKSHOP
  HALL
  FIELD
}

enum TimetableStatus {
  DRAFT
  PENDING
  PUBLISHED
  SUPERSEDED
}

enum RegisterSession {
  AM
  PM
  LESSON
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  SUSPENDED
  EXEAT
}

enum ExcuseReason {
  SICK
  FAMILY
  SCHOOL_ACTIVITY
  OTHER
}

enum SchemeStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum OutboxStatus {
  QUEUED
  SENT
  FAILED
}

enum SubjectChangeKind {
  CREATE
  UPDATE
  DEACTIVATE
  REACTIVATE
}

// Settings of the Academics module, one row per school (created the first time they are read).
model AcademicsSettings {
  id                     String   @id @default(cuid())
  schoolId               String   @unique
  // Afternoon register as well as the morning one.
  afternoonRegister      Boolean  @default(false)
  // A register for each lesson, opened from the timetable.
  perLessonAttendance    Boolean  @default(false)
  lessonPlans            Boolean  @default(false)
  // Subjects a student takes: O Level (Forms 1-4) and A Level (Forms 5-6).
  minSubjectsOLevel      Int      @default(8)
  maxSubjectsOLevel      Int      @default(10)
  minSubjectsALevel      Int      @default(3)
  maxSubjectsALevel      Int      @default(4)
  // The most periods a teacher should teach in a week.
  maxPeriodsPerWeek      Int      @default(36)
  // SMS to the primary guardian when a student is absent without a reason (needs the Communication module).
  absentSmsAlert         Boolean  @default(true)
  // Notice to the class teacher and Deputy about chronic absence.
  chronicAbsenceAlert    Boolean  @default(true)
  consecutiveAbsentDays  Int      @default(3)
  attendanceThresholdPct Int      @default(90)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

// One class teacher per class per term (the CLASS_TEACHER role, scoped to the class, is kept in step with it).
model ClassTeacher {
  id        String   @id @default(cuid())
  schoolId  String
  classId   String
  termId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School       @relation(fields: [schoolId], references: [id])
  class  SchoolClass  @relation(fields: [classId], references: [id])
  term   AcademicTerm @relation(fields: [termId], references: [id])
  user   User         @relation(fields: [userId], references: [id])

  @@unique([classId, termId])
  @@index([schoolId])
  @@index([userId, termId])
}

model Department {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  hodUserId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school       School                  @relation(fields: [schoolId], references: [id])
  hod          User?                   @relation("DepartmentHod", fields: [hodUserId], references: [id])
  subjects     Subject[]
  examVerifier ExamDepartmentVerifier?

  @@unique([schoolId, name])
  @@index([schoolId])
}

// Which forms offer a subject, and whether it is core (every student) or an elective (chosen) there.
model SubjectLevel {
  id        String      @id @default(cuid())
  schoolId  String
  subjectId String
  levelId   String
  type      SubjectType @default(CORE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  school  School  @relation(fields: [schoolId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  level   Level   @relation(fields: [levelId], references: [id])

  @@unique([subjectId, levelId])
  @@index([schoolId])
  @@index([levelId])
}

// A change to the subject list waits here for Head approval (academics.subjects.approve).
model SubjectChange {
  id            String            @id @default(cuid())
  schoolId      String
  kind          SubjectChangeKind
  subjectId     String?
  // The subject as it should be after the change (the same shape the form sends).
  payload       Json
  status        ApprovalState     @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, status])
}

model SubjectCombination {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school  School                    @relation(fields: [schoolId], references: [id])
  level   Level                     @relation(fields: [levelId], references: [id])
  items   SubjectCombinationItem[]
  classes SubjectCombinationClass[]

  @@unique([schoolId, levelId, name])
  @@index([schoolId])
}

model SubjectCombinationItem {
  id            String   @id @default(cuid())
  schoolId      String
  combinationId String
  subjectId     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  combination SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  subject     Subject            @relation(fields: [subjectId], references: [id])

  @@unique([combinationId, subjectId])
  @@index([schoolId])
}

model SubjectCombinationClass {
  id            String   @id @default(cuid())
  schoolId      String
  combinationId String
  classId       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  combination SubjectCombination @relation(fields: [combinationId], references: [id], onDelete: Cascade)
  class       SchoolClass        @relation(fields: [classId], references: [id])

  @@unique([combinationId, classId])
  @@index([schoolId])
}

// Exactly which subjects a student takes in a term. Exams, report cards and per-lesson attendance read this.
model StudentSubject {
  id        String               @id @default(cuid())
  schoolId  String
  studentId String
  subjectId String
  termId    String
  source    StudentSubjectSource @default(CHOSEN)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@index([schoolId])
  @@index([termId, subjectId])
}

// An elective taught across classes ("Form 3 Accounts"): its students come from StudentSubject.
model TeachingGroup {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String
  name      String
  subjectId String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school      School                 @relation(fields: [schoolId], references: [id])
  term        AcademicTerm           @relation(fields: [termId], references: [id])
  subject     Subject                @relation(fields: [subjectId], references: [id])
  level       Level                  @relation(fields: [levelId], references: [id])
  students    TeachingGroupStudent[]
  assignments TeacherAssignment[]

  @@unique([schoolId, termId, name])
  @@index([schoolId])
  @@index([termId, subjectId])
}

model TeachingGroupStudent {
  id        String   @id @default(cuid())
  schoolId  String
  groupId   String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school  School        @relation(fields: [schoolId], references: [id])
  group   TeachingGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student Student       @relation(fields: [studentId], references: [id])

  @@unique([groupId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

// One teacher teaches one subject to one class (or teaching group) in one term. Timetable, attendance, schemes
// and marks hang off it. Changing the teacher mid-term ENDS this row and starts another, so what was recorded
// keeps its teacher. Partial unique indexes (migration) keep one ACTIVE row per term, subject and class/group.
model TeacherAssignment {
  id             String           @id @default(cuid())
  schoolId       String
  termId         String
  teacherId      String
  coTeacherId    String?
  subjectId      String
  classId        String?
  groupId        String?
  periodsPerWeek Int              @default(4)
  doublesPerWeek Int              @default(0)
  startDate      DateTime         @db.Date
  endDate        DateTime?        @db.Date
  status         AssignmentStatus @default(ACTIVE)
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @default(now()) @updatedAt

  school          School           @relation(fields: [schoolId], references: [id])
  term            AcademicTerm     @relation(fields: [termId], references: [id])
  teacher         User             @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  coTeacher       User?            @relation("AssignmentCoTeacher", fields: [coTeacherId], references: [id])
  subject         Subject          @relation(fields: [subjectId], references: [id])
  class           SchoolClass?     @relation(fields: [classId], references: [id])
  group           TeachingGroup?   @relation(fields: [groupId], references: [id])
  slots           TimetableSlot[]
  schemes         SchemeOfWork[]
  assessments     Assessment[]
  assessmentMarks AssessmentMark[]
  markSheets      MarkSheet[]

  @@index([schoolId])
  @@index([termId, teacherId])
  @@index([termId, classId])
}

// The whole set of a term's teacher assignments goes to the Head for approval as one (one row per term).
model AssignmentSet {
  id            String    @id @default(cuid())
  schoolId      String
  termId        String
  status        SetStatus @default(DRAFT)
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  school School       @relation(fields: [schoolId], references: [id])
  term   AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([termId])
  @@index([schoolId])
}

// The bell schedule. termId empty = applies to every term; a schedule with a term replaces it for that term.
model BellSchedule {
  id        String   @id @default(cuid())
  schoolId  String
  termId    String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school  School        @relation(fields: [schoolId], references: [id])
  term    AcademicTerm? @relation(fields: [termId], references: [id])
  periods Period[]

  @@index([schoolId])
}

// One row per period per weekday (dayOfWeek 1 = Monday ... 6 = Saturday). Times are school-local "HH:MM".
model Period {
  id         String     @id @default(cuid())
  schoolId   String
  scheduleId String
  periodNo   Int
  dayOfWeek  Int
  label      String?
  start      String
  end        String
  type       PeriodType @default(LESSON)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @default(now()) @updatedAt

  school      School                @relation(fields: [schoolId], references: [id])
  schedule    BellSchedule          @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  slots       TimetableSlot[]
  unavailable TeacherAvailability[]

  @@unique([scheduleId, dayOfWeek, periodNo])
  @@index([schoolId])
}

model Room {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  type      RoomType @default(CLASSROOM)
  capacity  Int      @default(45)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school         School          @relation(fields: [schoolId], references: [id])
  slots          TimetableSlot[]
  examPaperRooms ExamPaperRoom[]
  invigilations  Invigilation[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Timetable {
  id            String          @id @default(cuid())
  schoolId      String
  termId        String
  version       Int
  status        TimetableStatus @default(DRAFT)
  effectiveFrom DateTime?       @db.Date
  submittedById String?
  approvedById  String?
  publishedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  school School          @relation(fields: [schoolId], references: [id])
  term   AcademicTerm    @relation(fields: [termId], references: [id])
  slots  TimetableSlot[]

  @@unique([termId, version])
  @@index([schoolId])
}

// A lesson in a period. teacherId and classId are copied from the assignment so the database itself can refuse a
// teacher, class or room in two places at once (partial unique indexes per timetable version). A double period is
// two rows (consecutive periods) that share pairId.
model TimetableSlot {
  id           String   @id @default(cuid())
  schoolId     String
  timetableId  String
  assignmentId String
  periodId     String
  roomId       String?
  teacherId    String
  classId      String?
  isDouble     Boolean  @default(false)
  pairId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school      School               @relation(fields: [schoolId], references: [id])
  timetable   Timetable            @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  assignment  TeacherAssignment    @relation(fields: [assignmentId], references: [id])
  period      Period               @relation(fields: [periodId], references: [id])
  room        Room?                @relation(fields: [roomId], references: [id])
  teacher     User                 @relation("SlotTeacher", fields: [teacherId], references: [id])
  covers      CoverLesson[]
  registers   AttendanceRegister[]
  lessonPlans LessonPlan[]

  @@index([schoolId])
  @@index([timetableId, assignmentId])
  @@index([periodId])
}

// Periods a teacher cannot teach (set per teacher).
model TeacherAvailability {
  id        String   @id @default(cuid())
  schoolId  String
  userId    String
  periodId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  period Period @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([userId, periodId])
  @@index([schoolId])
}

// A relief lesson: someone covers a lesson of an absent teacher on one date.
model CoverLesson {
  id              String   @id @default(cuid())
  schoolId        String
  date            DateTime @db.Date
  slotId          String
  absentTeacherId String
  coverTeacherId  String
  assignedById    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  school        School        @relation(fields: [schoolId], references: [id])
  slot          TimetableSlot @relation(fields: [slotId], references: [id])
  absentTeacher User          @relation("CoverAbsent", fields: [absentTeacherId], references: [id])
  coverTeacher  User          @relation("CoverTeacher", fields: [coverTeacherId], references: [id])

  @@unique([date, slotId])
  @@index([schoolId, date])
  @@index([coverTeacherId, date])
}

// The daily register of a class (session AM / PM) or the register of one lesson (session LESSON, with slotId).
// changedAt is when the marks were last changed on the device that saved them: when two devices changed the same
// register the later changedAt wins, and both versions are kept in the audit log.
model AttendanceRegister {
  id         String          @id @default(cuid())
  schoolId   String
  termId     String
  classId    String?
  slotId     String?
  date       DateTime        @db.Date
  session    RegisterSession @default(AM)
  markedById String
  markedAt   DateTime        @default(now())
  syncedAt   DateTime        @default(now())
  changedAt  DateTime        @default(now())
  deviceId   String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt

  school  School            @relation(fields: [schoolId], references: [id])
  term    AcademicTerm      @relation(fields: [termId], references: [id])
  class   SchoolClass?      @relation(fields: [classId], references: [id])
  slot    TimetableSlot?    @relation(fields: [slotId], references: [id])
  entries AttendanceEntry[]

  @@index([schoolId, date])
  @@index([termId, classId])
}

model AttendanceEntry {
  id          String           @id @default(cuid())
  schoolId    String
  registerId  String
  studentId   String
  status      AttendanceStatus @default(PRESENT)
  reason      ExcuseReason?
  reasonNote  String?
  arrivalTime String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  school   School             @relation(fields: [schoolId], references: [id])
  register AttendanceRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)
  student  Student            @relation(fields: [studentId], references: [id])

  @@unique([registerId, studentId])
  @@index([schoolId])
  @@index([studentId])
}

// Messages waiting for the Communication module's gateway (SMS to guardians about absences).
model MessageOutbox {
  id         String       @id @default(cuid())
  schoolId   String
  channel    String       @default("SMS")
  toPhone    String
  body       String
  studentId  String?
  guardianId String?
  dedupeKey  String?
  status     OutboxStatus @default(QUEUED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, dedupeKey])
  @@index([schoolId, status])
}

// The tree of topics of a subject at a level: Mathematics Form 2 > Algebra > Simultaneous equations.
model SyllabusTopic {
  id         String   @id @default(cuid())
  schoolId   String
  subjectId  String
  levelId    String
  parentId   String?
  title      String
  objectives String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school           School            @relation(fields: [schoolId], references: [id])
  subject          Subject           @relation(fields: [subjectId], references: [id])
  level            Level             @relation(fields: [levelId], references: [id])
  parent           SyllabusTopic?    @relation("TopicTree", fields: [parentId], references: [id])
  children         SyllabusTopic[]   @relation("TopicTree")
  assessmentTopics AssessmentTopic[]

  @@index([schoolId, subjectId, levelId])
}

// A syllabus one school shares for the others to start from. It holds topics only, no school data, so it has no
// schoolId and is not row-level secured.
model SyllabusTemplate {
  id             String   @id @default(cuid())
  name           String
  subjectName    String
  levelOrder     Int
  topics         Json
  sharedBySchool String
  createdAt      DateTime @default(now())

  @@index([subjectName, levelOrder])
}

model SchemeOfWork {
  id            String       @id @default(cuid())
  schoolId      String
  termId        String
  assignmentId  String
  status        SchemeStatus @default(DRAFT)
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  returnComment String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  school     School            @relation(fields: [schoolId], references: [id])
  term       AcademicTerm      @relation(fields: [termId], references: [id])
  assignment TeacherAssignment @relation(fields: [assignmentId], references: [id])
  weeks      SchemeWeek[]

  @@unique([assignmentId])
  @@index([schoolId, termId])
}

model SchemeWeek {
  id         String   @id @default(cuid())
  schoolId   String
  schemeId   String
  weekNo     Int
  startDate  DateTime @db.Date
  topicIds   String[] @default([])
  objectives String?
  activities String?
  resources  String?
  assessment String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school      School        @relation(fields: [schoolId], references: [id])
  scheme      SchemeOfWork  @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  record      RecordOfWork?
  lessonPlans LessonPlan[]

  @@unique([schemeId, weekNo])
  @@index([schoolId])
}

model RecordOfWork {
  id              String   @id @default(cuid())
  schoolId        String
  schemeWeekId    String   @unique
  coveredTopicIds String[] @default([])
  extraNotes      String?
  problems        String?
  recordedById    String
  recordedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  school School     @relation(fields: [schoolId], references: [id])
  week   SchemeWeek @relation(fields: [schemeWeekId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model LessonPlan {
  id           String   @id @default(cuid())
  schoolId     String
  slotId       String
  date         DateTime @db.Date
  schemeWeekId String?
  teacherId    String
  content      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school School        @relation(fields: [schoolId], references: [id])
  slot   TimetableSlot @relation(fields: [slotId], references: [id])
  week   SchemeWeek?   @relation(fields: [schemeWeekId], references: [id])

  @@unique([slotId, date])
  @@index([schoolId])
}

// ─── Examinations: assessment setup, marks, mark sheets, results ─────────────
//
// Marks belong to a student, an assessment and a teacher assignment. They are never deleted (database trigger), and
// every change after the sheet was first submitted is kept in AssessmentMarkChange. Results are calculated by
// lib/results and copied onto SubjectResult / TermResult, so changing the grading scale later never changes a
// published grade. (The older Mark / MarkChange tables belong to the first results screens and stay until those are retired.)
// Columns named ...ById that point at a User are plain text: the database checks them (check_same_school) without a foreign key.

enum MarkCode {
  AB
  EX
  NS
  AB_EXCUSED
}

enum CombineRule {
  AVERAGE
  BEST_N
  BY_MAX
}

enum MarkSheetStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  VERIFIED
  PUBLISHED
  RETURNED
  UNLOCKED
}

enum SheetAction {
  SUBMIT
  VERIFY
  RETURN
  UNLOCK
  PUBLISH
  UNPUBLISH
}

enum CommentCategory {
  SUBJECT
  CLASS_TEACHER
  HEAD
}

// The school's editable list: Class test, Assignment, Practical, Mid-term test, End-of-term exam, Mock exam, School-based project, Other.
model AssessmentType {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  isProject  Boolean  @default(false)
  // Set once by the Exams Officer for every class of a subject at a level (end-of-term exam, mocks), never by one teacher.
  commonExam Boolean  @default(false)
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school      School                  @relation(fields: [schoolId], references: [id])
  planTypes   WeightingPlanItemType[]
  assessments Assessment[]
  examPeriods ExamPeriod[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

// What counts towards a subject's term mark: one plan per term and level, optionally overridden for one subject.
// Partial unique indexes (migration) keep one level plan and one subject plan per term and level.
model WeightingPlan {
  id          String   @id @default(cuid())
  schoolId    String
  termId      String
  levelId     String
  subjectId   String?
  name        String
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  school  School              @relation(fields: [schoolId], references: [id])
  term    AcademicTerm        @relation(fields: [termId], references: [id])
  level   Level               @relation(fields: [levelId], references: [id])
  subject Subject?            @relation(fields: [subjectId], references: [id])
  items   WeightingPlanItem[]

  @@index([schoolId])
  @@index([termId, levelId])
}

// One line of a plan ("Class tests and assignments, 20%, average of all"). It can cover several assessment types.
model WeightingPlanItem {
  id          String      @id @default(cuid())
  schoolId    String
  planId      String
  label       String
  weight      Decimal     @db.Decimal(5, 2)
  combineRule CombineRule @default(AVERAGE)
  bestN       Int?
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  school School                  @relation(fields: [schoolId], references: [id])
  plan   WeightingPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  types  WeightingPlanItemType[]

  @@index([schoolId])
  @@index([planId])
}

model WeightingPlanItemType {
  id        String   @id @default(cuid())
  schoolId  String
  itemId    String
  typeId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School            @relation(fields: [schoolId], references: [id])
  item   WeightingPlanItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type   AssessmentType    @relation(fields: [typeId], references: [id])

  @@unique([itemId, typeId])
  @@index([schoolId])
}

// A school-based project that can be reused in later terms: stages, each with a maximum mark or a rubric.
model ProjectTemplate {
  id            String    @id @default(cuid())
  schoolId      String
  title         String
  subjectId     String
  levelId       String
  startDate     DateTime? @db.Date
  dueDate       DateTime? @db.Date
  briefFileKey  String?
  briefFileName String?
  active        Boolean   @default(true)
  copiedFromId  String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  school      School         @relation(fields: [schoolId], references: [id])
  subject     Subject        @relation(fields: [subjectId], references: [id])
  level       Level          @relation(fields: [levelId], references: [id])
  stages      ProjectStage[]
  assessments Assessment[]

  @@index([schoolId])
  @@index([schoolId, subjectId, levelId])
}

model ProjectStage {
  id         String   @id @default(cuid())
  schoolId   String
  templateId String
  name       String
  sortOrder  Int      @default(0)
  maxMark    Decimal  @db.Decimal(8, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  school   School           @relation(fields: [schoolId], references: [id])
  template ProjectTemplate  @relation(fields: [templateId], references: [id], onDelete: Cascade)
  rubric   Rubric?
  marks    AssessmentMark[]

  @@index([schoolId])
  @@index([templateId])
}

model Rubric {
  id        String   @id @default(cuid())
  schoolId  String
  stageId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school   School            @relation(fields: [schoolId], references: [id])
  stage    ProjectStage      @relation(fields: [stageId], references: [id], onDelete: Cascade)
  criteria RubricCriterion[]

  @@index([schoolId])
}

model RubricCriterion {
  id        String   @id @default(cuid())
  schoolId  String
  rubricId  String
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School        @relation(fields: [schoolId], references: [id])
  rubric Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  levels RubricLevel[]
  scores RubricScore[]

  @@index([schoolId])
  @@index([rubricId])
}

model RubricLevel {
  id          String   @id @default(cuid())
  schoolId    String
  criterionId String
  label       String
  descriptor  String?
  marks       Decimal  @db.Decimal(8, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  school    School          @relation(fields: [schoolId], references: [id])
  criterion RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  scores    RubricScore[]

  @@index([schoolId])
  @@index([criterionId])
}

// One test, assignment, exam or project. Private to one teacher assignment (assignmentId set), or common to every class
// of a subject at a level (assignmentId null: the end-of-term exam and mocks the Exams Officer sets once for everyone).
// The maximum mark is fixed once a mark exists (database trigger).
model Assessment {
  id           String    @id @default(cuid())
  schoolId     String
  termId       String
  assignmentId String?
  levelId      String
  subjectId    String
  typeId       String
  projectId    String?
  title        String
  date         DateTime? @db.Date
  maxMark      Decimal   @db.Decimal(8, 2)
  countsToTerm Boolean   @default(true)
  copiedFromId String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  school      School             @relation(fields: [schoolId], references: [id])
  term        AcademicTerm       @relation(fields: [termId], references: [id])
  assignment  TeacherAssignment? @relation(fields: [assignmentId], references: [id])
  level       Level              @relation(fields: [levelId], references: [id])
  subject     Subject            @relation(fields: [subjectId], references: [id])
  type        AssessmentType     @relation(fields: [typeId], references: [id])
  project     ProjectTemplate?   @relation(fields: [projectId], references: [id])
  topics      AssessmentTopic[]
  marks       AssessmentMark[]
  examPaperId String?            @unique
  examPaper   ExamPaper?         @relation(fields: [examPaperId], references: [id])

  @@index([schoolId])
  @@index([termId, subjectId, levelId])
  @@index([assignmentId])
}

model AssessmentTopic {
  id           String   @id @default(cuid())
  schoolId     String
  assessmentId String
  topicId      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school     School        @relation(fields: [schoolId], references: [id])
  assessment Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  topic      SyllabusTopic @relation(fields: [topicId], references: [id])

  @@unique([assessmentId, topicId])
  @@index([schoolId])
}

// A student's mark in an assessment (or in one stage of a project), entered under a teacher assignment.
// value is null when a code (AB, EX, NS, AB_EXCUSED) stands instead, or when nothing has been entered yet.
// Never deleted. Unique per (assessment, student, stage): two partial indexes in the migration (stage null or not).
model AssessmentMark {
  id              String    @id @default(cuid())
  schoolId        String
  assessmentId    String
  assignmentId    String
  studentId       String
  stageId         String?
  value           Decimal?  @db.Decimal(8, 2)
  code            MarkCode?
  enteredById     String
  // When the teacher typed it on their device; the later of two offline versions wins.
  clientChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  school       School                 @relation(fields: [schoolId], references: [id])
  assessment   Assessment             @relation(fields: [assessmentId], references: [id])
  assignment   TeacherAssignment      @relation(fields: [assignmentId], references: [id])
  student      Student                @relation(fields: [studentId], references: [id])
  stage        ProjectStage?          @relation(fields: [stageId], references: [id])
  changes      AssessmentMarkChange[]
  rubricScores RubricScore[]
  evidence     MarkEvidence[]

  @@index([schoolId])
  @@index([assessmentId])
  @@index([assignmentId])
  @@index([studentId])
}

// The level a teacher clicked for one criterion of a rubric.
model RubricScore {
  id          String   @id @default(cuid())
  schoolId    String
  markId      String
  criterionId String
  levelId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  school    School          @relation(fields: [schoolId], references: [id])
  mark      AssessmentMark  @relation(fields: [markId], references: [id])
  criterion RubricCriterion @relation(fields: [criterionId], references: [id])
  level     RubricLevel     @relation(fields: [levelId], references: [id])

  @@unique([markId, criterionId])
  @@index([schoolId])
}

// A photo or file showing a student's project work, for moderation.
model MarkEvidence {
  id           String   @id @default(cuid())
  schoolId     String
  markId       String
  fileKey      String
  fileName     String?
  contentType  String?
  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school School         @relation(fields: [schoolId], references: [id])
  mark   AssessmentMark @relation(fields: [markId], references: [id])

  @@index([schoolId])
  @@index([markId])
}

// Append-only (database trigger): every change to a mark after its sheet was first submitted.
model AssessmentMarkChange {
  id          String    @id @default(cuid())
  schoolId    String
  markId      String
  sheetId     String?
  oldValue    Decimal?  @db.Decimal(8, 2)
  oldCode     MarkCode?
  newValue    Decimal?  @db.Decimal(8, 2)
  newCode     MarkCode?
  changedById String
  reason      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  school School         @relation(fields: [schoolId], references: [id])
  mark   AssessmentMark @relation(fields: [markId], references: [id])
  sheet  MarkSheet?     @relation(fields: [sheetId], references: [id])

  @@index([schoolId])
  @@index([markId])
  @@index([sheetId])
}

// One teacher assignment's marks for the term: the unit that is submitted, verified, published and unlocked.
model MarkSheet {
  id               String          @id @default(cuid())
  schoolId         String
  assignmentId     String
  termId           String
  status           MarkSheetStatus @default(NOT_STARTED)
  firstSubmittedAt DateTime?
  submittedAt      DateTime?
  submittedById    String?
  verifiedById     String?
  verifiedAt       DateTime?
  returnedComment  String?
  returnedById     String?
  returnedAt       DateTime?
  unlockedById     String?
  unlockedAt       DateTime?
  unlockReason     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  school     School                 @relation(fields: [schoolId], references: [id])
  assignment TeacherAssignment      @relation(fields: [assignmentId], references: [id])
  term       AcademicTerm           @relation(fields: [termId], references: [id])
  events     MarkSheetEvent[]
  comments   SheetStudentComment[]
  changes    AssessmentMarkChange[]

  @@unique([assignmentId, termId])
  @@index([schoolId])
  @@index([termId, status])
}

// Who moved a sheet, when and why: the record behind "each way back is a named action by a named person".
model MarkSheetEvent {
  id         String          @id @default(cuid())
  schoolId   String
  sheetId    String
  action     SheetAction
  fromStatus MarkSheetStatus
  toStatus   MarkSheetStatus
  actorId    String
  comment    String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt

  school School    @relation(fields: [schoolId], references: [id])
  sheet  MarkSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([sheetId])
}

// The subject teacher's short comment on a student, written on the mark sheet and copied onto the result.
model SheetStudentComment {
  id        String   @id @default(cuid())
  schoolId  String
  sheetId   String
  studentId String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school  School    @relation(fields: [schoolId], references: [id])
  sheet   MarkSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id])

  @@unique([sheetId, studentId])
  @@index([schoolId])
}

// Calculated by lib/results from verified mark sheets; frozen (published) when the Head publishes the class.
model SubjectResult {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  subjectId       String
  termId          String
  classId         String
  levelId         String
  assignmentId    String?
  termMark        Decimal   @db.Decimal(7, 2)
  roundedMark     Int
  grade           String?
  points          Int?
  remark          String?
  classPosition   Int?
  classSize       Int?
  formPosition    Int?
  formSize        Int?
  teacherComment  String?
  teacherInitials String?
  // [{ label, score, weight }] for each line of the plan, for the report card.
  typeScores      Json?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  calculatedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])
  class   SchoolClass  @relation(fields: [classId], references: [id])

  @@unique([studentId, subjectId, termId])
  @@index([schoolId])
  @@index([termId, classId])
  @@index([termId, levelId, subjectId])
}

// The class teacher's overall comment and the Head's remark, written before the results are published
// (published TermResult rows copy them).
model ReportComment {
  id                  String   @id @default(cuid())
  schoolId            String
  studentId           String
  termId              String
  classId             String
  classTeacherComment String?
  classTeacherById    String?
  headRemark          String?
  headRemarkById      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])
  class   SchoolClass  @relation(fields: [classId], references: [id])

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([termId, classId])
}

model CommentBankItem {
  id        String          @id @default(cuid())
  schoolId  String
  category  CommentCategory
  text      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@index([schoolId, category])
}

// Examinations settings, one row per school (made the first time they are read).
model ExamSettings {
  id                     String   @id @default(cuid())
  schoolId               String   @unique
  englishSubjectId       String?
  mathsSubjectId         String?
  // Passes needed (including English and Mathematics) for the O Level flag.
  passesRequired         Int      @default(5)
  // Standard deviations from the class mean that raise a warning in the mark grid.
  outlierSd              Decimal  @default(3) @db.Decimal(4, 2)
  subjectCommentsEnabled Boolean  @default(true)
  // Report card parts and layout.
  showSubjectPositions   Boolean  @default(true)
  showClassPosition      Boolean  @default(true)
  showFormPosition       Boolean  @default(true)
  showTypeScores         Boolean  @default(true)
  showAttendance         Boolean  @default(true)
  showConduct            Boolean  @default(false)
  showPreviousAverage    Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

// The dates the Exams Officer sets each term for entering, submitting and verifying marks.
model ExamDeadline {
  id        String    @id @default(cuid())
  schoolId  String
  termId    String
  entryDue  DateTime? @db.Date
  submitDue DateTime? @db.Date
  verifyDue DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  school School       @relation(fields: [schoolId], references: [id])
  term   AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([termId])
  @@index([schoolId])
}

// Who verifies a department's mark sheets when its Head of Department is the teacher (another HOD or the Deputy).
model ExamDepartmentVerifier {
  id           String   @id @default(cuid())
  schoolId     String
  departmentId String   @unique
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school     School     @relation(fields: [schoolId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])

  @@index([schoolId])
}

// ─── Examinations: exam timetable, invigilation, seating ─────────────────────

enum ExamPeriodStatus {
  DRAFT
  PENDING
  APPROVED
}

enum ExamSession {
  MORNING
  AFTERNOON
}

enum ExamAttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum ExamIncidentType {
  MALPRACTICE
  ILLNESS
  DISRUPTION
  OTHER
}

// A named run of papers: "Term 3 end-of-term exams 2026", "Form 4 mocks". Normal lessons are suspended for the levels that sit it.
model ExamPeriod {
  id            String           @id @default(cuid())
  schoolId      String
  termId        String
  name          String
  startDate     DateTime         @db.Date
  endDate       DateTime         @db.Date
  // The kind of assessment its papers feed (End-of-term exam, Mock exam): each paper makes the assessment its marks land in.
  typeId        String
  status        ExamPeriodStatus @default(DRAFT)
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  createdById   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  school School            @relation(fields: [schoolId], references: [id])
  term   AcademicTerm      @relation(fields: [termId], references: [id])
  type   AssessmentType    @relation(fields: [typeId], references: [id])
  levels ExamPeriodLevel[]
  papers ExamPaper[]

  @@index([schoolId])
  @@index([termId, status])
}

model ExamPeriodLevel {
  id        String   @id @default(cuid())
  schoolId  String
  periodId  String
  levelId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School     @relation(fields: [schoolId], references: [id])
  period ExamPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  level  Level      @relation(fields: [levelId], references: [id])

  @@unique([periodId, levelId])
  @@index([schoolId])
}

model ExamPaper {
  id              String      @id @default(cuid())
  schoolId        String
  periodId        String
  subjectId       String
  levelId         String
  paperNumber     Int         @default(1)
  name            String
  durationMinutes Int
  date            DateTime    @db.Date
  session         ExamSession
  startTime       String
  maxMark         Decimal     @db.Decimal(8, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  school        School           @relation(fields: [schoolId], references: [id])
  period        ExamPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  subject       Subject          @relation(fields: [subjectId], references: [id])
  level         Level            @relation(fields: [levelId], references: [id])
  rooms         ExamPaperRoom[]
  invigilations Invigilation[]
  attendance    ExamAttendance[]
  incidents     ExamIncident[]
  assessment    Assessment?

  @@unique([periodId, subjectId, levelId, paperNumber])
  @@index([schoolId])
  @@index([periodId, date, session])
}

// A room used for a paper, and how many candidates it can seat for an exam (fewer than a lesson, to keep desks apart).
model ExamPaperRoom {
  id           String   @id @default(cuid())
  schoolId     String
  paperId      String
  roomId       String
  examCapacity Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  school School    @relation(fields: [schoolId], references: [id])
  paper  ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  room   Room      @relation(fields: [roomId], references: [id])

  @@unique([paperId, roomId])
  @@index([schoolId])
}

model Invigilation {
  id        String   @id @default(cuid())
  schoolId  String
  paperId   String
  roomId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school School    @relation(fields: [schoolId], references: [id])
  paper  ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  room   Room      @relation(fields: [roomId], references: [id])

  @@unique([paperId, roomId, userId])
  @@index([schoolId])
  @@index([userId])
}

model ExamAttendance {
  id          String               @id @default(cuid())
  schoolId    String
  paperId     String
  studentId   String
  roomId      String?
  status      ExamAttendanceStatus
  arrivalTime String?
  markedById  String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt

  school  School    @relation(fields: [schoolId], references: [id])
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student   @relation(fields: [studentId], references: [id])

  @@unique([paperId, studentId])
  @@index([schoolId])
}

model ExamIncident {
  id                   String           @id @default(cuid())
  schoolId             String
  paperId              String
  roomId               String?
  studentId            String?
  type                 ExamIncidentType
  description          String
  reportedById         String
  occurredAt           DateTime         @default(now())
  // Suspected malpractice is also recorded in Discipline (category Exam dishonesty).
  disciplineIncidentId String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @default(now()) @updatedAt

  school  School    @relation(fields: [schoolId], references: [id])
  paper   ExamPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  student Student?  @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([paperId])
}

// ─── Examinations: ZIMSEC and Cambridge registration and results ─────────────

enum ExamBoard {
  ZIMSEC
  CAMBRIDGE
}

enum BoardSessionStatus {
  OPEN
  APPROVED
}

enum AmendmentKind {
  CANDIDATE_ADDED
  CANDIDATE_REMOVED
  SUBJECT_ADDED
  SUBJECT_REMOVED
  DETAILS_CHANGED
}

// One sitting with a board: "ZIMSEC November 2027, O Level". Fees, dates, subject codes and the export layout are entered by the
// Exams Officer each session because the board changes them; nothing here is hard-coded.
model BoardSession {
  id                 String             @id @default(cuid())
  schoolId           String
  board              ExamBoard
  category           LevelCategory
  session            String
  centreNumber       String
  registrationOpens  DateTime?          @db.Date
  registrationCloses DateTime?          @db.Date
  feePerSubject      Decimal            @db.Decimal(10, 2)
  fixedFee           Decimal            @default(0) @db.Decimal(10, 2)
  currency           Currency           @default(USD)
  photoRequired      Boolean            @default(true)
  // Grades that count as a pass, best first ("A,B,C" for O Level), and points for A Level ({"A":5,"B":4 ...}).
  passGrades         String[]
  gradePoints        Json?
  // Columns of the export, in order (see lib/exams/board-export.ts).
  exportColumns      String[]
  // One row per candidate (subjects in columns), or one row per candidate and subject.
  exportLayout       String             @default("CANDIDATE")
  status             BoardSessionStatus @default(OPEN)
  approvedById       String?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  school     School             @relation(fields: [schoolId], references: [id])
  codes      BoardSubjectCode[]
  candidates Candidate[]
  results    BoardResult[]
  amendments BoardAmendment[]

  @@unique([schoolId, board, category, session])
  @@index([schoolId])
}

model BoardSubjectCode {
  id        String   @id @default(cuid())
  schoolId  String
  sessionId String
  code      String
  name      String
  subjectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  school  School           @relation(fields: [schoolId], references: [id])
  session BoardSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  subject Subject?         @relation(fields: [subjectId], references: [id])
  entries CandidateEntry[]
  results BoardResult[]

  @@unique([sessionId, code])
  @@index([schoolId])
}

// A candidate: a student of the school, or a private candidate (a re-sitter registering at the school as a centre).
model Candidate {
  id              String    @id @default(cuid())
  schoolId        String
  sessionId       String
  studentId       String?
  // Private candidates only: the details a student record would hold.
  fullName        String?
  gender          Gender?
  dateOfBirth     DateTime? @db.Date
  idNumber        String?
  phone           String?
  // The name exactly as on the birth certificate, when it differs from the student record.
  certificateName String?
  candidateNumber String?
  // The Exams Officer has checked the name against the birth certificate.
  nameChecked     Boolean   @default(false)
  // Ticked by hand when Finance is off (or the payment was made another way).
  feePaidManual   Boolean   @default(false)
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  school  School           @relation(fields: [schoolId], references: [id])
  session BoardSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student?         @relation(fields: [studentId], references: [id])
  entries CandidateEntry[]
  results BoardResult[]

  @@index([schoolId])
  @@index([sessionId])
  @@index([studentId])
}

model CandidateEntry {
  id          String   @id @default(cuid())
  schoolId    String
  candidateId String
  codeId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  school    School           @relation(fields: [schoolId], references: [id])
  candidate Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  code      BoardSubjectCode @relation(fields: [codeId], references: [id])

  @@unique([candidateId, codeId])
  @@index([schoolId])
}

// A released grade. Attached to the student record (and so the alumni record) when the candidate is a student of the school.
model BoardResult {
  id              String   @id @default(cuid())
  schoolId        String
  sessionId       String
  candidateId     String?
  studentId       String?
  candidateNumber String
  codeId          String
  grade           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  school    School           @relation(fields: [schoolId], references: [id])
  session   BoardSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidate Candidate?       @relation(fields: [candidateId], references: [id])
  student   Student?         @relation(fields: [studentId], references: [id])
  code      BoardSubjectCode @relation(fields: [codeId], references: [id])

  @@unique([sessionId, candidateNumber, codeId])
  @@index([schoolId])
  @@index([studentId])
}

// After the Head approves the entry list, every change is logged here as an amendment.
model BoardAmendment {
  id          String        @id @default(cuid())
  schoolId    String
  sessionId   String
  candidateId String?
  kind        AmendmentKind
  detail      String
  madeById    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  session BoardSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([sessionId])
}

// ─── Finance module ──────────────────────────────────────────────────────────
// Money is whole cents (Int), never a float. Every amount carries its currency and the two currencies are never added.
// Nothing here is edited or deleted: only the workflow columns of a payment, adjustment, refund or request move forward
// (PENDING → VERIFIED …), a mistake is a new row (FinVoid, a credit note, a refund), and a balance is always calculated
// from the rows (lib/finance/balances.ts), never stored. The database refuses the rest (migration 20261103000000).
// Foreign keys to School, User and Level are written in the migration; they are plain ids here.

enum FundKind {
  TUITION
  SDC_LEVY
  BOARDING
  BUILDING
  EXAMS
  GENERAL
  OTHER
  TRUST
  TUCKSHOP
}

enum FinPaymentStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
}

enum AdjustmentKind {
  CREDIT_NOTE
  DISCOUNT
  BURSARY
  WAIVER
  SIBLING
  STAFF_CHILD
  EARLY_PAYMENT
  HARDSHIP
  HEAD_DISCRETION
  CORRECTION
  SPONSOR
}

enum FinApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FinRefundStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
}

enum ChargeSource {
  FEE_ITEM
  MANUAL
  LIBRARY
  EXAM_ENTRY
  MIGRATED
  ONE_OFF
  ADMISSION
  BOARDING_CHANGE
  DIFFERENCE
  FACILITIES
}

enum FinExpenseSource {
  REQUEST
  DIRECT
  MIGRATED
}

// Tuition, SDC levies and boarding fees belong to different funds; every report can be filtered by fund.
model Fund {
  id            String   @id @default(cuid())
  schoolId      String
  code          String
  name          String
  kind          FundKind @default(OTHER)
  // Each fund can have its own bank account and receipt book prefix (RCP, SDC ...).
  bankAccount   String?
  receiptPrefix String?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  feeItems FinFeeItem[]
  charges  FinCharge[]
  payments FinPayment[]
  requests FinExpenseRequest[]
  expenses FinExpense[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

// What a term costs: one line per fee, for a form (or all forms) and for day scholars, boarders or both.
model FinFeeItem {
  id             String        @id @default(cuid())
  schoolId       String
  termId         String
  levelId        String?
  boarding       BoardingType?
  fundId         String
  name           String
  currency       Currency
  amountCents    Int
  active         Boolean       @default(true)
  // The fee structure (a version for the term) this line belongs to, and the fee item of the school's list.
  structureId    String?
  catalogItemId  String?
  levelIds       String[]      @default([])
  classIds       String[]      @default([])
  combinationIds String[]      @default([])
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  term      AcademicTerm     @relation(fields: [termId], references: [id])
  fund      Fund             @relation(fields: [fundId], references: [id])
  structure FinFeeStructure? @relation(fields: [structureId], references: [id])
  charges   FinCharge[]

  @@index([schoolId, termId])
}

// What a student owes. Never changed or deleted: a mistake is a void (FinVoid) or a credit note (FinAdjustment).
model FinCharge {
  id             String       @id @default(cuid())
  schoolId       String
  studentId      String
  termId         String
  fundId         String
  feeItemId      String?
  description    String
  currency       Currency
  amountCents    Int
  source         ChargeSource @default(MANUAL)
  dueDate        DateTime?    @db.Date
  catalogItemId  String?
  billingRunId   String?
  createdById    String?
  createdAt      DateTime     @default(now())
  legacyChargeId String?      @unique

  student     Student                @relation(fields: [studentId], references: [id])
  term        AcademicTerm           @relation(fields: [termId], references: [id])
  fund        Fund                   @relation(fields: [fundId], references: [id])
  feeItem     FinFeeItem?            @relation(fields: [feeItemId], references: [id])
  adjustments FinAdjustment[]
  allocations FinPaymentAllocation[]
  refunds     FinRefund[]
  voidRow     FinVoid?

  @@unique([studentId, feeItemId])
  @@index([schoolId, studentId])
  @@index([schoolId, termId])
  @@index([schoolId, fundId])
}

// Money received. It reduces a balance only once someone other than the person who recorded it has verified it.
model FinPayment {
  id               String           @id @default(cuid())
  schoolId         String
  studentId        String
  fundId           String?
  // The official receipt number: at once for cash, at verification for everything else. ackNumber is the slip given before that.
  receiptNumber    String?
  ackNumber        String           @default("")
  // A family payment names the fee-payer guardian; studentId is then one of that guardian's children.
  guardianId       String?
  paidInZig        Boolean          @default(false)
  zigAmountCents   Int?
  exchangeRateId   String?
  paynowRef        String?
  verifyCode       String           @default("")
  backdateReason   String?
  currency         Currency
  amountCents      Int
  method           PaymentMethod
  reference        String?
  paidBy           String?
  receivedOn       DateTime         @db.Date
  note             String?
  proofKey         String?
  // The charge the payer said this money is for; it is settled first when the payment is verified (the rest goes oldest first).
  targetChargeId   String?
  status           FinPaymentStatus @default(PENDING)
  recordedById     String
  recordedAt       DateTime         @default(now())
  verifiedById     String?
  verifiedAt       DateTime?
  // The verifier held the permission only through "*" (Owner or Administrator): the school had no other finance person.
  verifierFallback Boolean          @default(false)
  rejectedById     String?
  rejectedAt       DateTime?
  rejectionReason  String?
  legacyPaymentId  String?          @unique

  student     Student                @relation(fields: [studentId], references: [id])
  fund        Fund?                  @relation(fields: [fundId], references: [id])
  allocations FinPaymentAllocation[]
  refunds     FinRefund[]
  voidRow     FinVoid?

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, studentId])
  @@index([schoolId, status])
  @@index([schoolId, receivedOn])
}

// How much of a verified payment settles which charge (same student, currency and fund). A payment can be split over charges.
model FinPaymentAllocation {
  id          String   @id @default(cuid())
  schoolId    String
  paymentId   String
  chargeId    String
  amountCents Int
  createdById String
  createdAt   DateTime @default(now())

  payment FinPayment @relation(fields: [paymentId], references: [id])
  charge  FinCharge  @relation(fields: [chargeId], references: [id])

  @@index([schoolId, paymentId])
  @@index([schoolId, chargeId])
}

// A credit note, discount, bursary or waiver against one charge. It counts only once a second person approves it.
model FinAdjustment {
  id           String            @id @default(cuid())
  schoolId     String
  chargeId     String
  kind         AdjustmentKind
  amountCents  Int
  percentBps   Int?
  ruleId       String?
  reason       String
  status       FinApprovalStatus @default(PENDING)
  createdById  String
  createdAt    DateTime          @default(now())
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  charge FinCharge @relation(fields: [chargeId], references: [id])

  @@index([schoolId, chargeId])
  @@index([schoolId, status])
}

// Money handed back. Asked for by one person, approved by a second, paid out by a third.
// With a charge it reverses what a payment had settled (the balance rises again); without one it returns unallocated credit.
model FinRefund {
  id              String          @id @default(cuid())
  schoolId        String
  paymentId       String
  chargeId        String?
  amountCents     Int
  reason          String
  reasonKind      String          @default("OTHER")
  method          PaymentMethod?
  reference       String?
  status          FinRefundStatus @default(REQUESTED)
  requestedById   String
  requestedAt     DateTime        @default(now())
  approvedById    String?
  approvedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  paidById        String?
  paidAt          DateTime?

  payment FinPayment @relation(fields: [paymentId], references: [id])
  charge  FinCharge? @relation(fields: [chargeId], references: [id])

  @@index([schoolId, paymentId])
  @@index([schoolId, status])
}

// "This was a mistake": one row per voided payment, expense or charge. The original stays and is left out of every total.
model FinVoid {
  id         String   @id @default(cuid())
  schoolId   String
  paymentId  String?  @unique
  expenseId  String?  @unique
  chargeId   String?  @unique
  reason     String
  voidedById String
  voidedAt   DateTime @default(now())

  payment FinPayment? @relation(fields: [paymentId], references: [id])
  expense FinExpense? @relation(fields: [expenseId], references: [id])
  charge  FinCharge?  @relation(fields: [chargeId], references: [id])

  @@index([schoolId])
}

// A request to spend: raised by one person, approved by a second, paid by a third. Only a paid request becomes an expense.
model FinExpenseRequest {
  id                   String             @id @default(cuid())
  schoolId             String
  requestNumber        String
  title                String
  type                 ExpenseRequestType
  department           String
  justification        String
  fundId               String
  currency             Currency
  estimatedCents       Int
  status               RequestStatus      @default(DRAFT)
  requestedById        String
  createdAt            DateTime           @default(now())
  submittedAt          DateTime?
  approvedById         String?
  approvedAt           DateTime?
  rejectedById         String?
  rejectedAt           DateTime?
  rejectionReason      String?
  disbursedById        String?
  disbursedAt          DateTime?
  neededBy             DateTime?          @db.Date
  supplierId           String?
  quoteKeys            String[]           @default([])
  // Above the Head's limit the Owner approves after the Head: the Head's approval is recorded here, the Owner's as approvedBy.
  firstApprovedById    String?
  firstApprovedAt      DateTime?
  // What may be paid: the approved total, raised only by an approved overrun.
  approvedCeilingCents Int?
  overrunCents         Int?
  overrunApprovedById  String?
  cancelledById        String?
  cancelledAt          DateTime?
  legacyRequestId      String?            @unique

  fund    Fund                    @relation(fields: [fundId], references: [id])
  items   FinExpenseRequestItem[]
  expense FinExpense?

  @@unique([schoolId, requestNumber])
  @@index([schoolId, status])
  @@index([schoolId, requestedById])
}

model FinExpenseRequestItem {
  id          String @id @default(cuid())
  schoolId    String
  requestId   String
  description String
  quantity    Int    @default(1)
  unitCents   Int
  totalCents  Int

  request FinExpenseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

// Money that left the school: a paid request, or a direct expense the bursar recorded. Never edited; a mistake is a void.
model FinExpense {
  id              String           @id @default(cuid())
  schoolId        String
  fundId          String
  category        String
  description     String
  payee           String?
  currency        Currency
  amountCents     Int
  paidOn          DateTime         @db.Date
  method          PaymentMethod
  reference       String?
  source          FinExpenseSource
  supplierId      String?
  categoryId      String?
  receiptKey      String?
  payrollRunId    String?
  requestId       String?          @unique
  recordedById    String
  createdAt       DateTime         @default(now())
  legacyExpenseId String?          @unique

  fund    Fund               @relation(fields: [fundId], references: [id])
  request FinExpenseRequest? @relation(fields: [requestId], references: [id])
  voidRow FinVoid?

  @@index([schoolId, paidOn])
  @@index([schoolId, fundId])
}

// The school's money controls (one row per school, made the first time anyone needs it).
model FinSettings {
  id                           String   @id @default(cuid())
  schoolId                     String   @unique
  // The most the bursar may record as a direct expense without a request, per currency; null = no limit.
  directLimitUsdCents          Int?
  directLimitZigCents          Int?
  // Non-cash payments need a reference (receipt number, transfer id).
  requireReference             Boolean  @default(true)
  // Sibling discount: percent off the chosen fee items for the 2nd and the 3rd-and-later child of one fee payer (set by the bursar, approved by the Head).
  siblingPct2Bps               Int?
  siblingPct3Bps               Int?
  siblingItemIds               String[] @default([])
  siblingSetById               String?
  siblingApprovedById          String?
  applyCreditAtBilling         Boolean  @default(true)
  prorateAdmission             Boolean  @default(false)
  autoBillOnAdmission          Boolean  @default(true)
  allocationMode               String   @default("OLDEST_FUND")
  proofAboveUsdCents           Int?
  proofAboveZigCents           Int?
  receiptRequiredAboveUsdCents Int?
  receiptRequiredAboveZigCents Int?
  quotesAboveUsdCents          Int?
  quotesAboveZigCents          Int?
  quotesRequired               Int      @default(3)
  headLimitUsdCents            Int?
  headLimitZigCents            Int?
  overrunPercent               Int      @default(10)
  staleRateDays                Int      @default(3)
  cashToleranceCents           Int      @default(100)
  reminderLeadDays             Int      @default(3)
  paynowEnabled                Boolean  @default(false)
  paynowId                     String?
  paynowKey                    String?
  arrearsSmsTemplate           String   @default("Dear {guardian}, {student} owes {amount} in school fees. Please pay at the school office or online. Thank you.")
  // True once the school runs its money in this module: the older accounting screens then stop writing (lib/finance/legacy-guard.ts).
  legacyRetired                Boolean  @default(true)
  updatedAt                    DateTime @updatedAt
}

// ─── Finance, part 2: fee setup, billing, sponsors, controls, spending, payroll hand-over ───────────────
// Foreign keys to School/User and between plain-id columns are written in the migration (20261104000000_finance_full).

enum FinFeeStructureStatus {
  DRAFT
  SUBMITTED
  APPROVED
  SUPERSEDED
}

enum SponsorType {
  BEAM
  CHURCH
  NGO
  COMPANY
  INDIVIDUAL
}

enum AwardStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ENDED
}

enum PlanStatus {
  PENDING_APPROVAL
  ACTIVE
  COMPLETED
  CANCELLED
}

enum InstalmentStatus {
  DUE
  PAID
  MISSED
}

enum CashUpStatus {
  OPEN
  SUBMITTED
  CONFIRMED
  SIGNED_OFF
}

enum BankLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

enum PettyKind {
  TOPUP
  EXPENSE
}

enum PayrollStatus {
  READY
  PAID
  // The HR run was reopened by the Owner before anything was paid; nothing in this hand-over can be paid any more.
  CANCELLED
}

enum StatutoryType {
  PAYE
  NSSA
  ZIMDEF
  AIDS_LEVY
}

// The school's list of things it charges for (Tuition, SDC levy, Boarding fee ...). Each belongs to a fund.
model FeeItem {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  fundId    String
  recurring Boolean  @default(true)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId])
}

// What each learner pays in one term. Draft, submitted, approved by the Head; only an approved structure can be billed, and once
// billed it is never edited: a change is a new version, and the difference is billed as an adjustment.
model FinFeeStructure {
  id            String                @id @default(cuid())
  schoolId      String
  termId        String
  version       Int                   @default(1)
  status        FinFeeStructureStatus @default(DRAFT)
  note          String?
  createdById   String
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  billedAt      DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  lines FinFeeItem[]
  runs  BillingRun[]

  @@unique([termId, version])
  @@index([schoolId, termId])
}

model BillingRun {
  id              String   @id @default(cuid())
  schoolId        String
  termId          String
  structureId     String
  runById         String
  charged         Int      @default(0)
  skippedCharged  Int      @default(0)
  skippedInactive Int      @default(0)
  awardsCents     Json?
  result          Json?
  createdAt       DateTime @default(now())

  structure FinFeeStructure @relation(fields: [structureId], references: [id])

  @@index([schoolId, termId])
}

// A discount, waiver or award the school gives: fixed or a percentage of chosen fee items, for one term or standing until an end term.
model DiscountRule {
  id             String            @id @default(cuid())
  schoolId       String
  studentId      String
  kind           AdjustmentKind
  amountCents    Int?
  percentBps     Int?
  currency       Currency?
  catalogItemIds String[]          @default([])
  termFromId     String
  termToId       String?
  standing       Boolean           @default(false)
  reason         String
  status         FinApprovalStatus @default(PENDING)
  createdById    String
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime          @default(now())

  @@index([schoolId, studentId])
  @@index([schoolId, status])
}

// A fee statement for a learner, or one for a family (a fee-payer guardian with all their children). The figures are a snapshot.
model Invoice {
  id          String   @id @default(cuid())
  schoolId    String
  number      String
  studentId   String?
  guardianId  String?
  termId      String
  data        Json
  createdById String
  createdAt   DateTime @default(now())

  @@unique([schoolId, number])
  @@index([schoolId, termId])
}

// Someone other than the parent who owes the money: BEAM, a church, an NGO, a company.
model Sponsor {
  id            String      @id @default(cuid())
  schoolId      String
  name          String
  type          SponsorType
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  awards   SponsorAward[]
  charges  SponsorCharge[]
  payments SponsorPayment[]

  @@index([schoolId])
}

model SponsorAward {
  id             String      @id @default(cuid())
  schoolId       String
  sponsorId      String
  studentId      String
  catalogItemIds String[]    @default([])
  percentBps     Int?
  amountCents    Int?
  currency       Currency
  termFromId     String
  termToId       String?
  reference      String?
  status         AwardStatus @default(PENDING)
  createdById    String
  approvedById   String?
  approvedAt     DateTime?
  cancelledById  String?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime    @default(now())

  sponsor Sponsor @relation(fields: [sponsorId], references: [id])

  @@index([schoolId, studentId])
  @@index([schoolId, sponsorId])
}

// The part of a learner's charge that the sponsor owes. The sponsor's account is these rows minus the payments allocated to them.
model SponsorCharge {
  id           String   @id @default(cuid())
  schoolId     String
  sponsorId    String
  awardId      String
  studentId    String
  chargeId     String
  adjustmentId String?
  termId       String
  fundId       String
  currency     Currency
  amountCents  Int
  // CANCELLED when the award is cancelled and the amount goes back to the parent.
  cancelled    Boolean  @default(false)
  createdAt    DateTime @default(now())

  sponsor     Sponsor                    @relation(fields: [sponsorId], references: [id])
  allocations SponsorPaymentAllocation[]

  @@unique([awardId, chargeId])
  @@index([schoolId, sponsorId])
}

// Money received from a sponsor (a BEAM grant, a church). Recorded, verified by someone else, then allocated to the learners it covers.
model SponsorPayment {
  id              String           @id @default(cuid())
  schoolId        String
  sponsorId       String
  currency        Currency
  amountCents     Int
  method          PaymentMethod
  reference       String?
  receivedOn      DateTime         @db.Date
  receiptNumber   String?
  ackNumber       String
  proofKey        String?
  status          FinPaymentStatus @default(PENDING)
  recordedById    String
  recordedAt      DateTime         @default(now())
  verifiedById    String?
  verifiedAt      DateTime?
  rejectedById    String?
  rejectedAt      DateTime?
  rejectionReason String?
  voidedById      String?
  voidedAt        DateTime?
  voidReason      String?

  sponsor     Sponsor                    @relation(fields: [sponsorId], references: [id])
  allocations SponsorPaymentAllocation[]

  @@unique([schoolId, receiptNumber])
  @@index([schoolId, sponsorId])
}

model SponsorPaymentAllocation {
  id              String   @id @default(cuid())
  schoolId        String
  paymentId       String
  sponsorChargeId String
  amountCents     Int
  createdById     String
  createdAt       DateTime @default(now())

  payment       SponsorPayment @relation(fields: [paymentId], references: [id])
  sponsorCharge SponsorCharge  @relation(fields: [sponsorChargeId], references: [id])

  @@index([schoolId, paymentId])
  @@index([schoolId, sponsorChargeId])
}

// Credit moved to a brother or sister on the same fee payer. It is a verified payment on the receiving account (method CREDIT_TRANSFER)
// that a second person verifies, and it takes the same amount out of the source payment's credit.
model CreditTransfer {
  id            String   @id @default(cuid())
  schoolId      String
  fromStudentId String
  toStudentId   String
  fromPaymentId String
  toPaymentId   String   @unique
  currency      Currency
  amountCents   Int
  reason        String
  createdById   String
  createdAt     DateTime @default(now())

  @@index([schoolId, fromPaymentId])
}

// An agreement to pay a debt in instalments. The Head approves plans longer than one term.
model PaymentPlan {
  id           String     @id @default(cuid())
  schoolId     String
  guardianId   String
  studentIds   String[]   @default([])
  currency     Currency
  totalCents   Int
  startDate    DateTime   @db.Date
  notes        String?
  status       PlanStatus @default(ACTIVE)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())

  instalments PaymentPlanInstalment[]

  @@index([schoolId, guardianId])
}

model PaymentPlanInstalment {
  id             String           @id @default(cuid())
  schoolId       String
  planId         String
  dueDate        DateTime         @db.Date
  amountCents    Int
  status         InstalmentStatus @default(DUE)
  paidAt         DateTime?
  reminderSentAt DateTime?
  missedAlertAt  DateTime?

  plan PaymentPlan @relation(fields: [planId], references: [id])

  @@index([schoolId, dueDate])
}

// One clerk's day: the cash counted against the cash the system expects, confirmed by the bursar and signed off by the Head.
model CashUp {
  id                 String       @id @default(cuid())
  schoolId           String
  userId             String
  date               DateTime     @db.Date
  expectedUsdCents   Int          @default(0)
  expectedZigCents   Int          @default(0)
  countedUsdCents    Int          @default(0)
  countedZigCents    Int          @default(0)
  differenceUsdCents Int          @default(0)
  differenceZigCents Int          @default(0)
  explanation        String?
  status             CashUpStatus @default(OPEN)
  submittedAt        DateTime?
  confirmedById      String?
  confirmedAt        DateTime?
  signedOffById      String?
  signedOffAt        DateTime?
  depositRef         String?
  createdAt          DateTime     @default(now())

  @@unique([schoolId, userId, date])
  @@index([schoolId, date])
}

model BankMapping {
  id        String   @id @default(cuid())
  schoolId  String
  bank      String
  mapping   Json
  updatedAt DateTime @updatedAt

  @@unique([schoolId, bank])
}

model BankStatement {
  id           String    @id @default(cuid())
  schoolId     String
  account      String
  currency     Currency
  periodFrom   DateTime? @db.Date
  periodTo     DateTime? @db.Date
  fileName     String
  uploadedById String
  createdAt    DateTime  @default(now())

  lines BankStatementLine[]

  @@index([schoolId])
}

model BankStatementLine {
  id                      String         @id @default(cuid())
  schoolId                String
  statementId             String
  date                    DateTime       @db.Date
  amountCents             Int
  reference               String?
  description             String?
  status                  BankLineStatus @default(UNMATCHED)
  matchedPaymentId        String?
  matchedSponsorPaymentId String?
  matchedDepositRef       String?

  statement BankStatement @relation(fields: [statementId], references: [id])

  @@index([schoolId, statementId])
}

model Supplier {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  contact     String?
  phone       String?
  bankDetails String?
  ecocash     String?
  taxNumber   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, name])
}

model ExpenseCategory {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
}

model Budget {
  id          String   @id @default(cuid())
  schoolId    String
  termId      String
  fundId      String
  categoryId  String
  currency    Currency
  amountCents Int
  updatedAt   DateTime @updatedAt

  @@unique([termId, fundId, categoryId, currency])
  @@index([schoolId, termId])
}

// A float held by one custodian: topped up from the bursar, spent on small things, counted at each cash-up.
model PettyCashFloat {
  id                String   @id @default(cuid())
  schoolId          String
  custodianId       String
  currency          Currency
  expenseLimitCents Int
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())

  entries PettyCashEntry[]

  @@unique([custodianId, currency])
}

model PettyCashEntry {
  id          String    @id @default(cuid())
  schoolId    String
  floatId     String
  kind        PettyKind
  amountCents Int
  description String
  categoryId  String?
  receiptKey  String?
  date        DateTime  @db.Date
  byId        String
  createdAt   DateTime  @default(now())

  float PettyCashFloat @relation(fields: [floatId], references: [id])

  @@index([schoolId, floatId])
}

// HR prepares the payroll and the Owner approves it; Finance only pays it. Until HR exists a run can be handed over here by code.
model PayrollRun {
  id           String        @id @default(cuid())
  schoolId     String
  period       String
  preparedById String
  approvedById String
  status       PayrollStatus @default(READY)
  paidById     String?
  paidAt       DateTime?
  // The HR payroll run this hand-over came from (null for runs handed over by code).
  hrRunId      String?
  createdAt    DateTime      @default(now())

  lines PayrollLine[]

  // One live hand-over per month: the database index ignores CANCELLED ones (migration 20261105000100_hr_core).
  @@index([schoolId, period])
}

model PayrollLine {
  id          String        @id @default(cuid())
  schoolId    String
  runId       String
  employee    String
  employeeRef String?
  currency    Currency
  netCents    Int
  method      PaymentMethod
  account     String?
  paid        Boolean       @default(false)
  reference   String?

  run PayrollRun @relation(fields: [runId], references: [id])

  @@index([runId])
}

model StatutoryPayment {
  id           String        @id @default(cuid())
  schoolId     String
  type         StatutoryType
  period       String
  currency     Currency
  amountCents  Int
  dueDate      DateTime      @db.Date
  paidAt       DateTime?
  paidById     String?
  reference    String?
  payrollRunId String?
  createdAt    DateTime      @default(now())

  @@index([schoolId, dueDate])
}

// Official receipt and acknowledgement numbers: one row per school, year and book prefix, locked while a number is taken.
model ReceiptSequence {
  id         String @id @default(cuid())
  schoolId   String
  year       Int
  prefix     String
  nextNumber Int    @default(1)

  @@unique([schoolId, year, prefix])
}

// A Paynow payment the parent started; the callback and the poll settle it.
model PaynowAttempt {
  id          String   @id @default(cuid())
  schoolId    String
  studentId   String
  guardianId  String?
  reference   String   @unique
  pollUrl     String?
  currency    Currency
  amountCents Int
  status      String   @default("CREATED")
  paymentId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId, studentId])
}

// ─── HR & Staff ──────────────────────────────────────────────────────────────
// One Employee per person who works at the school, whoever pays them. Rows are never deleted. Money is whole cents with a currency.
// References to User and to other HR rows are plain ids; the foreign keys and the same-school checks are in the migration SQL.

enum HrEmployer {
  GOVERNMENT
  SCHOOL
}

enum EmployeeCategory {
  TEACHING
  ADMINISTRATION
  ANCILLARY
  BOARDING
  SECURITY
  GROUNDS
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  RESIGNED
  RETIRED
  DISMISSED
  DECEASED
}

enum EmployeeExitReason {
  RESIGNATION
  END_OF_CONTRACT
  RETIREMENT
  DISMISSAL
  DEATH
}

enum ContractKind {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  CASUAL
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum VacancyStatus {
  OPEN
  CLOSED
  FILLED
}

enum ApplicantStage {
  APPLIED
  SHORTLISTED
  INTERVIEWED
  OFFERED
  HIRED
  REJECTED
}

enum StaffAttStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  OFFICIAL_DUTY
  HALF_DAY
}

enum StaffAttMethod {
  OFFICE
  SELF
  TABLET
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum RosterStatus {
  DRAFT
  APPROVED
  PUBLISHED
}

enum SwapStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  CONFIRMED
  CANCELLED
}

enum HrPayMethod {
  BANK
  ECOCASH
  CASH
}

enum PayBasis {
  MONTHLY
  DAILY
  HOURLY
}

enum ComponentKind {
  ALLOWANCE
  DEDUCTION
}

enum HrPayrollStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  RETURNED
}

enum LoanStatus {
  ACTIVE
  REPAID
  CANCELLED
}

enum ChangeGroup {
  DETAILS
  BANK
  NEXT_OF_KIN
}

enum ChangeRequestStatus {
  PENDING
  HR_APPROVED
  APPROVED
  REJECTED
}

enum DisciplineOutcome {
  VERBAL_WARNING
  WRITTEN_WARNING
  FINAL_WARNING
  SUSPENSION
  DISMISSAL
  NO_ACTION
}

enum SensitiveKind {
  SALARY
  PAYSLIP
  BANK
  NATIONAL_ID
  MEDICAL
  DISCIPLINE
}

// Counters (EMP-0042, letter references) that never repeat and never skip.
model HrSequence {
  id         String @id @default(cuid())
  schoolId   String
  key        String
  nextNumber Int    @default(1)

  @@unique([schoolId, key])
}

model HrSettings {
  id                   String   @id @default(cuid())
  schoolId             String   @unique
  lateAfter            String   @default("07:30")
  signInFrom           String   @default("05:30")
  signInUntil          String   @default("12:00")
  officeRegister       Boolean  @default(true)
  selfSignIn           Boolean  @default(false)
  tabletSignIn         Boolean  @default(false)
  signOutRequired      Boolean  @default(false)
  // Signs in only from the school's network: the caller passes the network check; the setting records the school's choice.
  wifiOnly             Boolean  @default(false)
  // The Head may hand teaching-staff leave approval to this user (usually the Deputy).
  leaveDelegateUserId  String?
  // ZiG per US$1, in hundredths (27.50 = 2750), for staff whose pay is split by a rule.
  payrollZigPerUsd     Int?
  netChangeFlagPct     Int      @default(10)
  payeDueDay           Int      @default(10)
  nssaDueDay           Int      @default(15)
  zimdefDueDay         Int      @default(15)
  absentAlertDays      Int      @default(3)
  contractReminderDays Int[]    @default([60, 30])
  // Days from the Calendar are used for working days; these are the weekdays worked (1 = Monday ... 7 = Sunday).
  workingWeekdays      Int[]    @default([1, 2, 3, 4, 5])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

model Employee {
  id            String              @id @default(cuid())
  schoolId      String
  employeeNo    String
  userId        String?             @unique
  title         String?
  firstName     String
  surname       String
  gender        Gender?
  dateOfBirth   DateTime?           @db.Date
  // Sensitive: HR, the Owner and the employee only.
  nationalId    String?
  medicalNotes  String?
  nationality   String?
  maritalStatus String?
  homeAddress   String?
  personalPhone String?
  personalEmail String?
  workPhone     String?
  photoKey      String?
  jobTitle      String
  departmentId  String?
  category      EmployeeCategory    @default(ANCILLARY)
  employer      HrEmployer          @default(SCHOOL)
  ecNumber      String?
  // The date the ministry posted a government teacher here.
  postedOn      DateTime?           @db.Date
  startDate     DateTime            @db.Date
  status        EmployeeStatus      @default(ACTIVE)
  lineManagerId String?
  // The establishment post this person fills (for filled / vacant counts).
  postId        String?
  leavingDate   DateTime?           @db.Date
  leavingReason EmployeeExitReason?
  // The 4-digit PIN of the shared office tablet, hashed.
  tabletPinHash String?
  createdById   String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt

  @@unique([schoolId, employeeNo])
  @@index([schoolId, status])
  @@index([schoolId, employer])
  @@index([schoolId, departmentId])
}

model EmployeeNextOfKin {
  id           String   @id @default(cuid())
  schoolId     String
  employeeId   String
  name         String
  relationship String
  phone        String
  address      String?
  isEmergency  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([schoolId, employeeId])
}

model EmployeeQualification {
  id          String    @id @default(cuid())
  schoolId    String
  employeeId  String
  // QUALIFICATION, SUBJECT (a subject they can teach) or REGISTRATION (a professional body).
  kind        String    @default("QUALIFICATION")
  title       String
  institution String?
  year        Int?
  documentKey String?
  expiresOn   DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([schoolId, employeeId])
}

model EmployeeDocument {
  id           String    @id @default(cuid())
  schoolId     String
  employeeId   String
  // CONTRACT, ID_COPY, CERTIFICATE, APPOINTMENT_LETTER, DISCIPLINARY, LETTER, OTHER
  kind         String
  title        String
  reference    String?
  // The text of a letter generated from a template (the letterhead and the signature are added when it is printed).
  body         String?
  fileKey      String?
  expiresOn    DateTime? @db.Date
  // Disciplinary papers: HR, the Head and the Owner only.
  restricted   Boolean   @default(false)
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt

  @@unique([schoolId, reference])
  @@index([schoolId, employeeId])
}

// Position, salary and status changes. Added to, never changed.
model EmployeeHistory {
  id            String   @id @default(cuid())
  schoolId      String
  employeeId    String
  field         String
  oldValue      String?
  newValue      String?
  effectiveDate DateTime @db.Date
  changedById   String
  reason        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([schoolId, employeeId, createdAt])
}

// A staff member asks to change their own details; HR approves. Bank changes also need the Owner.
model EmployeeChangeRequest {
  id               String              @id @default(cuid())
  schoolId         String
  employeeId       String
  group            ChangeGroup
  changes          Json
  reason           String?
  status           ChangeRequestStatus @default(PENDING)
  requestedById    String
  hrDecidedById    String?
  hrDecidedAt      DateTime?
  ownerDecidedById String?
  ownerDecidedAt   DateTime?
  rejectedById     String?
  rejectionReason  String?
  appliedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  @@index([schoolId, status])
  @@index([employeeId])
}

// Who looked at someone else's salary, payslip, bank details, ID number, medical notes or disciplinary record. Added to, never changed.
model HrSensitiveView {
  id         String        @id @default(cuid())
  schoolId   String
  employeeId String
  viewerId   String
  kind       SensitiveKind
  context    String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @default(now()) @updatedAt

  @@index([schoolId, employeeId, createdAt])
}

model StaffDisciplinary {
  id           String             @id @default(cuid())
  schoolId     String
  employeeId   String
  category     String
  description  String
  incidentDate DateTime           @db.Date
  hearingDate  DateTime?          @db.Date
  panel        String?
  outcome      DisciplineOutcome?
  appeal       String?
  documentKeys String[]           @default([])
  recordedById String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @default(now()) @updatedAt

  @@index([schoolId, employeeId])
}

// ── Establishment and recruitment ────────────────────────────────────────────

model Post {
  id                String           @id @default(cuid())
  schoolId          String
  title             String
  departmentId      String?
  category          EmployeeCategory @default(ANCILLARY)
  employer          HrEmployer       @default(SCHOOL)
  count             Int              @default(1)
  currency          Currency         @default(USD)
  monthlyCostCents  Int              @default(0)
  note              String?
  status            PostStatus       @default(PENDING)
  requestedById     String
  headApprovedById  String?
  headApprovedAt    DateTime?
  ownerApprovedById String?
  ownerApprovedAt   DateTime?
  // Set when the second of the two approvals lands.
  approvedById      String?
  rejectedById      String?
  rejectionReason   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @default(now()) @updatedAt

  @@index([schoolId, status])
}

model Vacancy {
  id           String        @id @default(cuid())
  schoolId     String
  postId       String
  title        String
  requirements String?
  closingDate  DateTime      @db.Date
  status       VacancyStatus @default(OPEN)
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now()) @updatedAt

  @@index([schoolId, status])
}

model Applicant {
  id              String         @id @default(cuid())
  schoolId        String
  vacancyId       String
  name            String
  phone           String?
  email           String?
  cvKey           String?
  qualifications  String?
  notes           String?
  stage           ApplicantStage @default(APPLIED)
  rejectionReason String?
  hiredEmployeeId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt

  @@index([schoolId, vacancyId, stage])
}

model InterviewScore {
  id             String   @id @default(cuid())
  schoolId       String
  applicantId    String
  panelistId     String
  criterion      String
  score          Int
  comment        String?
  // HIRE, CONSIDER or DO_NOT_HIRE; the same on every row of one panelist.
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([applicantId, panelistId, criterion])
  @@index([schoolId, applicantId])
}

model Contract {
  id                 String         @id @default(cuid())
  schoolId           String
  employeeId         String
  kind               ContractKind
  startDate          DateTime       @db.Date
  endDate            DateTime?      @db.Date
  probationEnd       DateTime?      @db.Date
  jobTitle           String
  gradeId            String?
  // pay, hours per week, notice period: the terms as agreed.
  terms              Json?
  // The generated contract and the signed copy.
  fileKey            String?
  signedFileKey      String?
  status             ContractStatus @default(DRAFT)
  previousContractId String?
  terminatedOn       DateTime?      @db.Date
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@index([schoolId, employeeId])
  @@index([schoolId, status, endDate])
}

model EmployeeExit {
  id             String             @id @default(cuid())
  schoolId       String
  employeeId     String             @unique
  reason         EmployeeExitReason
  lastDay        DateTime           @db.Date
  noticeServed   Boolean            @default(false)
  // Leave days owed paid out, deductions: lines { label, amountCents, currency, kind }.
  finalPay       Json?
  // keys returned, school property, library books: { item, done }.
  clearance      Json?
  certificateRef String?
  processedById  String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt
}

// ── Staff attendance ─────────────────────────────────────────────────────────

model StaffAttendance {
  id            String         @id @default(cuid())
  schoolId      String
  employeeId    String
  date          DateTime       @db.Date
  status        StaffAttStatus
  arrivalTime   String?
  departureTime String?
  method        StaffAttMethod @default(OFFICE)
  note          String?
  markedById    String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@unique([employeeId, date])
  @@index([schoolId, date])
}

// A change to a day that has passed: what it was, what it became, and why. Added to, never changed.
model StaffAttendanceChange {
  id          String   @id @default(cuid())
  schoolId    String
  employeeId  String
  date        DateTime @db.Date
  oldStatus   String?
  newStatus   String
  reason      String
  changedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([schoolId, employeeId, date])
}

// ── Leave ────────────────────────────────────────────────────────────────────

model LeaveType {
  id                   String   @id @default(cuid())
  schoolId             String
  code                 String
  name                 String
  daysPerYear          Float    @default(0)
  accruesMonthly       Boolean  @default(false)
  carryOverMax         Float    @default(0)
  // Sick leave: days on full pay and on half pay each year; certificate needed after this many days.
  fullPayDays          Float?
  halfPayDays          Float?
  certificateAfterDays Int?
  requiresAttachment   Boolean  @default(false)
  // Official duty is not taken off any balance.
  deductsBalance       Boolean  @default(true)
  // Unpaid days feed payroll.
  unpaid               Boolean  @default(false)
  // Maternity: a fixed number of calendar days from a start date, not school days.
  calendarDays         Boolean  @default(false)
  active               Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt

  @@unique([schoolId, code])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  schoolId    String
  employeeId  String
  leaveTypeId String
  year        Int
  carriedOver Float    @default(0)
  adjusted    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([employeeId, leaveTypeId, year])
}

// A manual change to a balance, with the reason. Added to, never changed.
model LeaveAdjustment {
  id           String   @id @default(cuid())
  schoolId     String
  employeeId   String
  leaveTypeId  String
  year         Int
  days         Float
  reason       String
  adjustedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([schoolId, employeeId, year])
}

model LeaveRequest {
  id              String      @id @default(cuid())
  schoolId        String
  employeeId      String
  leaveTypeId     String
  startDate       DateTime    @db.Date
  endDate         DateTime    @db.Date
  startHalfDay    Boolean     @default(false)
  endHalfDay      Boolean     @default(false)
  // Counted school days (or calendar days for maternity).
  days            Float
  reason          String?
  attachmentKey   String?
  handoverNotes   String?
  coverEmployeeId String?
  status          LeaveStatus @default(PENDING)
  requestedById   String
  approvedById    String?
  decidedAt       DateTime?
  decisionReason  String?
  // Government-paid teachers: recorded for the school; the formal application goes through the ministry.
  recordOnly      Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, employeeId, startDate])
}

// ── Duty roster ──────────────────────────────────────────────────────────────

model DutyType {
  id                 String             @id @default(cuid())
  schoolId           String
  name               String
  wholeDay           Boolean            @default(false)
  // Only these categories are eligible when auto-filling (empty = everyone who is eligible by default).
  eligibleCategories EmployeeCategory[] @default([])
  perDay             Int                @default(1)
  active             Boolean            @default(true)
  sortOrder          Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model DutyRoster {
  id           String       @id @default(cuid())
  schoolId     String
  label        String
  startDate    DateTime     @db.Date
  endDate      DateTime     @db.Date
  status       RosterStatus @default(DRAFT)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @default(now()) @updatedAt

  @@index([schoolId, startDate])
}

model DutyAssignment {
  id         String   @id @default(cuid())
  schoolId   String
  rosterId   String
  dutyTypeId String
  date       DateTime @db.Date
  employeeId String
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([rosterId, dutyTypeId, date, employeeId])
  @@index([schoolId, employeeId, date])
}

model DutySwap {
  id             String     @id @default(cuid())
  schoolId       String
  assignmentId   String
  fromEmployeeId String
  toEmployeeId   String
  status         SwapStatus @default(REQUESTED)
  reason         String?
  confirmedById  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  @@index([schoolId, status])
}

// ── Pay set-up ───────────────────────────────────────────────────────────────

model PayGrade {
  id            String   @id @default(cuid())
  schoolId      String
  code          String
  name          String
  basicUsdCents Int      @default(0)
  basicZigCents Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([schoolId, code])
}

// Sensitive. One row per school-paid employee; every change is logged in EmployeeHistory with before, after and a reason.
model EmployeePay {
  id                 String      @id @default(cuid())
  schoolId           String
  employeeId         String      @unique
  gradeId            String?
  payBasis           PayBasis    @default(MONTHLY)
  basicUsdCents      Int         @default(0)
  basicZigCents      Int         @default(0)
  // Split rule: this share of splitTotalUsdCents is paid in USD and the rest in ZiG at the payroll rate (replaces the two basics).
  splitUsdBps        Int?
  splitTotalUsdCents Int?
  // Casual and hourly staff: days or hours worked times this rate, in rateCurrency.
  rateCents          Int?
  rateCurrency       Currency?
  paymentMethod      HrPayMethod @default(BANK)
  bankName           String?
  bankBranch         String?
  accountNumber      String?
  ecocashNumber      String?
  zimraTaxNo         String?
  nssaNo             String?
  medicalAidNo       String?
  pensionNo          String?
  effectiveFrom      DateTime    @db.Date
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @default(now()) @updatedAt
}

model PayComponent {
  id                 String        @id @default(cuid())
  schoolId           String
  code               String
  name               String
  kind               ComponentKind
  taxable            Boolean       @default(true)
  // Variable components are entered each month in the run; fixed ones come from the employee's own values.
  variable           Boolean       @default(false)
  defaultAmountCents Int?
  active             Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt

  @@unique([schoolId, code])
}

model EmployeePayComponent {
  id             String    @id @default(cuid())
  schoolId       String
  employeeId     String
  componentId    String
  amountCents    Int
  currency       Currency  @default(USD)
  startsOn       DateTime  @db.Date
  endsOn         DateTime? @db.Date
  // Staff child fees: the employee's signed consent, and the child whose fees account receives the amount.
  childStudentId String?
  consentKey     String?
  consentAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([schoolId, employeeId])
}

model Loan {
  id              String     @id @default(cuid())
  schoolId        String
  employeeId      String
  principalCents  Int
  currency        Currency   @default(USD)
  instalmentCents Int
  balanceCents    Int
  startMonth      String
  status          LoanStatus @default(ACTIVE)
  reason          String?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([schoolId, employeeId, status])
}

// ── Statutory settings: append-only, effective-dated ─────────────────────────

model TaxTable {
  id            String    @id @default(cuid())
  schoolId      String
  currency      Currency
  effectiveFrom DateTime  @db.Date
  note          String?
  confirmedById String?
  confirmedAt   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([schoolId, currency, effectiveFrom])
}

model TaxBand {
  id        String   @id @default(cuid())
  schoolId  String
  tableId   String
  fromCents Int
  rateBps   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([tableId, fromCents])
}

model StatutoryRate {
  id                       String    @id @default(cuid())
  schoolId                 String
  effectiveFrom            DateTime  @db.Date
  aidsLevyBps              Int
  nssaEmployeeBps          Int
  nssaEmployerBps          Int
  nssaCeilingUsdCents      Int?
  nssaCeilingZigCents      Int?
  nssaDeductibleBeforePaye Boolean   @default(false)
  zimdefBps                Int
  note                     String?
  confirmedById            String?
  confirmedAt              DateTime?
  createdById              String
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @default(now()) @updatedAt

  @@unique([schoolId, effectiveFrom])
}

// ── Monthly payroll ──────────────────────────────────────────────────────────

model HrPayrollRun {
  id            String          @id @default(cuid())
  schoolId      String
  month         String
  status        HrPayrollStatus @default(DRAFT)
  preparedById  String
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  paidById      String?
  paidAt        DateTime?
  returnedById  String?
  returnComment String?
  reopenedById  String?
  reopenReason  String?
  // Totals per currency: { USD: { grossCents, payeCents, ... }, ZIG: { ... } }.
  totals        Json?
  // The Finance hand-over run created at approval.
  financeRunId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @default(now()) @updatedAt

  @@unique([schoolId, month])
  @@index([schoolId, status])
}

// One-off items for a month: overtime, bonuses, unpaid leave, casual days, and corrections of a past run (with the reason).
model HrPayrollVariable {
  id          String   @id @default(cuid())
  schoolId    String
  runId       String
  employeeId  String
  // OVERTIME, BONUS, DEDUCTION, UNPAID_DAYS, CASUAL_UNITS, ADJUSTMENT
  kind        String
  label       String
  amountCents Int      @default(0)
  currency    Currency @default(USD)
  units       Float?
  taxable     Boolean  @default(true)
  // ADJUSTMENT lines can be negative (a correction of an earlier month); they must carry a reason.
  reason      String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([schoolId, runId, employeeId])
}

// A snapshot: never recalculated after the run is approved.
model HrPayrollLine {
  id                String   @id @default(cuid())
  schoolId          String
  runId             String
  employeeId        String
  currency          Currency
  departmentId      String?
  earnings          Json
  deductions        Json
  grossCents        Int
  taxableCents      Int
  payeCents         Int
  aidsLevyCents     Int
  nssaEmployeeCents Int
  nssaEmployerCents Int
  zimdefCents       Int
  netCents          Int
  previousNetCents  Int?
  flags             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([runId, employeeId, currency])
  @@index([schoolId, runId])
}

model Payslip {
  id               String    @id @default(cuid())
  schoolId         String
  runId            String
  employeeId       String
  verificationCode String    @unique
  fileKey          String?
  releasedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@unique([runId, employeeId])
  @@index([schoolId, employeeId])
}

// ═════════════════════════════════════════════════════════════════════════════
// Facilities & Operations: hostel, exeats, sick bay, tuck shop, library, transport, inventory, assets.
// Every table is named Fac* because Asset, Book, SickBayVisit, Room and others already exist from earlier modules (they stay
// until the part that replaces them copies their rows across). Like the HR tables, a Fac table keeps its links as plain ids;
// the foreign keys, same-school checks, row-level security and audit triggers are written in the migration.
// Money is integer cents with a currency. USD and ZiG are never added together.
// ═════════════════════════════════════════════════════════════════════════════

enum FacBedType {
  SINGLE
  BUNK_TOP
  BUNK_BOTTOM
}

enum FacRollSession {
  MORNING
  EVENING
  LIGHTS_OUT
}

enum FacRollStatus {
  PRESENT
  ABSENT
  LATE
  EXEAT
  SICK_BAY
  SUSPENDED
}

enum FacExeatType {
  WEEKEND
  LONG
  MEDICAL
  EMERGENCY
  SCHOOL_ACTIVITY
}

enum FacExeatStatus {
  REQUESTED
  APPROVED
  REJECTED
  SIGNED_OUT
  RETURNED
  CANCELLED
}

enum FacComplaint {
  HEADACHE
  FEVER
  STOMACH_PAIN
  INJURY
  MENSTRUAL
  ASTHMA
  OTHER
}

enum FacVisitOutcome {
  BACK_TO_CLASS
  REST_IN_SICK_BAY
  SENT_TO_CLINIC
  SENT_HOME
}

enum FacWalletEntryType {
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REFUND
}

enum FacWalletClose {
  REFUNDED
  CARRIED_FORWARD
}

enum FacSalePayment {
  CASH
  WALLET
}

enum FacCopyCondition {
  NEW
  GOOD
  WORN
  DAMAGED
}

enum FacCopyStatus {
  AVAILABLE
  ON_LOAN
  RESERVED
  LOST
  WITHDRAWN
}

enum FacCopySource {
  BOUGHT
  DONATED
}

enum FacBookCategory {
  FICTION
  REFERENCE
  TEXTBOOK
  PAST_PAPERS
}

enum FacMemberType {
  LEARNER
  STAFF
}

enum FacStockCategory {
  UNIFORMS
  STATIONERY
  FOOD
  CLEANING
  MEDICAL
  AGRICULTURE
  MAINTENANCE
}

enum FacStockUnit {
  EACH
  BOX
  KG
  LITRE
}

enum FacMovementType {
  IN
  ISSUE
  SALE
  TRANSFER
  ADJUSTMENT
  WRITEOFF
}

enum FacWriteoffReason {
  EXPIRED
  DAMAGED
  STOLEN
  OTHER
}

enum FacCountStatus {
  OPEN
  SUBMITTED
  APPROVED
  CLOSED
}

enum FacAssetCondition {
  NEW
  GOOD
  FAIR
  POOR
}

enum FacAssetStatus {
  IN_USE
  IN_STORAGE
  UNDER_REPAIR
  LOST
  DISPOSED
}

enum FacDisposalMethod {
  SOLD
  SCRAPPED
  DONATED
  STOLEN
  LOST
}

enum FacJobStatus {
  REPORTED
  ASSIGNED
  DONE
  CANCELLED
}

enum FacScanResult {
  FOUND
  WRONG_PLACE
}

enum FacVehicleOwner {
  SCHOOL
  HIRED
}

enum FacVehicleDocType {
  LICENCE
  INSURANCE
  FITNESS
  ROUTE_PERMIT
}

enum FacDriverDocType {
  DRIVING_LICENCE
  DEFENSIVE_DRIVING
}

enum FacTripLeg {
  MORNING
  AFTERNOON
  OTHER
}

enum FacApproval {
  PENDING
  APPROVED
  REJECTED
}

// The parts that cost a learner money keep their own ledger when Finance is off (and say where the Finance charge is when it is on).
enum FacLedgerPart {
  HOSTEL
  LIBRARY
  TRANSPORT
  INVENTORY
  TUCKSHOP
}

enum FacLedgerStatus {
  OPEN
  SETTLED
  WAIVED
}

// ── Shared ──────────────────────────────────────────────────────────────────

model FacSettings {
  id                         String           @id @default(cuid())
  schoolId                   String           @unique
  // Hostel and exeats
  rollCallSessions           FacRollSession[] @default([MORNING, EVENING, LIGHTS_OUT])
  exeatHeadAlertMinutes      Int              @default(120)
  longExeatNights            Int              @default(3)
  // Library (learners 2 books for 14 days, staff 5 for 30 days)
  learnerMaxLoans            Int              @default(2)
  learnerLoanDays            Int              @default(14)
  staffMaxLoans              Int              @default(5)
  staffLoanDays              Int              @default(30)
  lateFinePerDayCents        Int              @default(0)
  lateFineCurrency           Currency         @default(USD)
  // Transport
  prorateTransport           Boolean          @default(true)
  // Limits above which a second person must approve (cents; USD and ZiG are compared only with their own kind).
  adjustmentLimitUsdCents    Int              @default(0)
  adjustmentLimitZigCents    Int              @default(0)
  disposalOwnerLimitUsdCents Int              @default(0)
  disposalOwnerLimitZigCents Int              @default(0)
  // Tuck shop
  walletLowBalanceCents      Int              @default(0)
  expiryWarningDays          Int              @default(30)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @default(now()) @updatedAt
}

model FacSequence {
  id         String   @id @default(cuid())
  schoolId   String
  key        String
  nextNumber Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([schoolId, key])
}

// What a learner owes for a facilities service when Finance is switched off (and the link to the Finance charge when it is on).
model FacLedgerEntry {
  id          String          @id @default(cuid())
  schoolId    String
  part        FacLedgerPart
  studentId   String
  termId      String?
  description String
  currency    Currency
  amountCents Int
  status      FacLedgerStatus @default(OPEN)
  // The Finance charge that now carries the amount, when Finance is on.
  chargeId    String?
  sourceType  String?
  sourceId    String?
  settledAt   DateTime?
  createdById String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([schoolId, part, status])
  @@index([schoolId, studentId])
}

// ── Hostel ──────────────────────────────────────────────────────────────────

model FacHostel {
  id               String   @id @default(cuid())
  schoolId         String
  name             String
  gender           Gender
  boardingMasterId String?
  matronId         String?
  capacity         Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model FacRoom {
  id        String   @id @default(cuid())
  schoolId  String
  hostelId  String
  name      String
  floor     String?
  capacity  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([hostelId, name])
  @@index([schoolId, hostelId])
}

model FacBed {
  id           String     @id @default(cuid())
  schoolId     String
  roomId       String
  number       String
  bedType      FacBedType @default(SINGLE)
  lockerNumber String?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  @@unique([roomId, number])
  @@index([schoolId, roomId])
}

model FacBedAllocation {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  bedId         String
  termId        String
  fromDate      DateTime  @db.Date
  toDate        DateTime? @db.Date
  reason        String?
  allocatedById String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, bedId])
  @@index([schoolId, termId])
}

model FacRollCall {
  id        String         @id @default(cuid())
  schoolId  String
  hostelId  String
  date      DateTime       @db.Date
  session   FacRollSession
  takenById String
  takenAt   DateTime       @default(now())
  // Idempotency key from the offline queue, so a re-sent roll call is not stored twice.
  clientId  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @default(now()) @updatedAt

  @@unique([schoolId, hostelId, date, session])
  @@unique([schoolId, clientId])
}

model FacRollCallEntry {
  id          String        @id @default(cuid())
  schoolId    String
  rollCallId  String
  studentId   String
  status      FacRollStatus
  // Exeat, sick bay and suspended entries are filled in by the system and cannot be changed by hand.
  locked      Boolean       @default(false)
  explainedBy String?
  note        String?
  alertedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([rollCallId, studentId])
  @@index([schoolId, studentId])
}

model FacInspection {
  id            String   @id @default(cuid())
  schoolId      String
  hostelId      String
  roomId        String
  date          DateTime @db.Date
  inspectedById String
  // Whole-room score out of 100.
  score         Int
  notes         String?
  photoKeys     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([schoolId, hostelId, date])
}

model FacInspectionItem {
  id                 String       @id @default(cuid())
  schoolId           String
  inspectionId       String
  // CLEANLINESS, BEDS_MADE, LOCKERS, DAMAGE or a word of the boarding master's own.
  item               String
  score              Int
  note               String?
  // Damage that becomes a charge needs the boarding master's approval.
  damageStudentId    String?
  damageCents        Int?
  damageCurrency     Currency?
  damageStatus       FacApproval?
  damageApprovedById String?
  ledgerEntryId      String?
  damageChargeId     String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @default(now()) @updatedAt

  @@index([schoolId, inspectionId])
}

// ── Exeats and visitors ─────────────────────────────────────────────────────

model FacExeat {
  id               String         @id @default(cuid())
  schoolId         String
  studentId        String
  type             FacExeatType
  outAt            DateTime
  dueBackAt        DateTime
  reason           String
  // { guardianId } for an authorised guardian, or { name, idNumber, phone, primaryConfirmedAt, primaryConfirmedBy, confirmMethod }.
  collectedBy      Json
  status           FacExeatStatus @default(REQUESTED)
  requestedById    String
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String?
  signedOutAt      DateTime?
  signedOutById    String?
  signedInAt       DateTime?
  signedInById     String?
  // When the boarding master and then the Head were told it is overdue.
  overdueAlertedAt DateTime?
  headAlertedAt    DateTime?
  // A general exeat weekend set on the Calendar.
  calendarEventId  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @default(now()) @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, status, dueBackAt])
}

model FacVisitorLog {
  id              String    @id @default(cuid())
  schoolId        String
  studentId       String
  visitorName     String
  idNumber        String?
  phone           String?
  // A guardian on record, or a visitor the boarding master approved.
  guardianId      String?
  approvedById    String?
  calendarEventId String?
  timeIn          DateTime
  timeOut         DateTime?
  loggedById      String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, timeIn])
}

// ── Sick bay ────────────────────────────────────────────────────────────────

model FacSickBayVisit {
  id                     String          @id @default(cuid())
  schoolId               String
  studentId              String
  visitedAt              DateTime
  complaint              FacComplaint
  complaintNote          String?
  temperatureC           Float?
  observations           String?
  treatment              String?
  // [{ name, dose, givenAt, stockItemId?, movementId? }]
  medication             Json            @default("[]")
  outcome                FacVisitOutcome
  guardianInformedAt     DateTime?
  guardianInformedMethod String?
  admittedAt             DateTime?
  dischargedAt           DateTime?
  // { facility, transport, accompaniedBy, followUp }
  referral               Json?
  recordedById           String
  legacyVisitId          String?         @unique
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, visitedAt])
}

model FacMedicationRound {
  id          String   @id @default(cuid())
  schoolId    String
  date        DateTime @db.Date
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([schoolId, date])
}

model FacMedicationDose {
  id                String    @id @default(cuid())
  schoolId          String
  roundId           String
  studentId         String
  medicationEntryId String?
  medicine          String
  dose              String?
  dueTime           String
  givenAt           DateTime?
  givenById         String?
  // Flagged when the round is closed without the dose being ticked.
  missed            Boolean   @default(false)
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @default(now()) @updatedAt

  @@index([schoolId, roundId])
  @@index([schoolId, studentId])
}

// ── Tuck shop and pocket money ──────────────────────────────────────────────

// One per boarder per currency. The balance is the sum of its entries, never a stored number.
model FacWallet {
  id               String          @id @default(cuid())
  schoolId         String
  studentId        String
  currency         Currency
  weeklyLimitCents Int?
  lowBalanceCents  Int?
  closedAt         DateTime?
  closeAction      FacWalletClose?
  closedById       String?
  // The guardian's written consent, uploaded, before a balance is ever used for fees.
  consentKey       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@unique([studentId, currency])
  @@index([schoolId])
}

model FacWalletEntry {
  id           String             @id @default(cuid())
  schoolId     String
  walletId     String
  currency     Currency
  // Plus for money in, minus for money out.
  amountCents  Int
  type         FacWalletEntryType
  // The Finance payment into the pocket-money fund, or the tuck shop sale.
  paymentId    String?
  saleId       String?
  note         String?
  // Cash handed to the learner, signed for on the phone.
  signatureKey String?
  createdById  String
  createdAt    DateTime           @default(now())

  @@index([schoolId, walletId, createdAt])
}

model FacTuckShopSale {
  id          String         @id @default(cuid())
  schoolId    String
  attendantId String
  studentId   String?
  walletId    String?
  payment     FacSalePayment
  currency    Currency
  totalCents  Int
  // What the stock sold cost (weighted average at the time), for profit.
  costCents   Int            @default(0)
  soldAt      DateTime       @default(now())
  cashUpId    String?
  // Idempotency key from the offline queue.
  clientId    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@unique([schoolId, clientId])
  @@index([schoolId, soldAt])
  @@index([schoolId, attendantId, soldAt])
}

model FacTuckShopSaleLine {
  id             String   @id @default(cuid())
  schoolId       String
  saleId         String
  stockItemId    String
  qty            Int
  unitPriceCents Int
  unitCostCents  Int      @default(0)
  movementId     String?
  createdAt      DateTime @default(now())

  @@index([schoolId, saleId])
}

model FacTuckShopCashUp {
  id                String   @id @default(cuid())
  schoolId          String
  attendantId       String
  date              DateTime @db.Date
  currency          Currency
  expectedCashCents Int
  countedCashCents  Int
  note              String?
  confirmedById     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([schoolId, attendantId, date, currency])
}

// ── Library and textbooks ───────────────────────────────────────────────────

model FacBookTitle {
  id               String          @id @default(cuid())
  schoolId         String
  title            String
  authors          String[]        @default([])
  isbn             String?
  publisher        String?
  year             Int?
  edition          String?
  subject          String?
  level            String?
  category         FacBookCategory @default(FICTION)
  shelfLocation    String?
  coverKey         String?
  // Reference books are not lent out.
  lendable         Boolean         @default(true)
  replacementCents Int?
  currency         Currency?
  legacyBookId     String?         @unique
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt

  @@index([schoolId])
  @@index([schoolId, isbn])
}

// The number of copies of a title is counted from these rows, never stored.
model FacBookCopy {
  id           String           @id @default(cuid())
  schoolId     String
  titleId      String
  accessionNo  String
  barcode      String
  condition    FacCopyCondition @default(NEW)
  status       FacCopyStatus    @default(AVAILABLE)
  source       FacCopySource    @default(BOUGHT)
  costCents    Int              @default(0)
  currency     Currency         @default(USD)
  legacyCopyId String?          @unique
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @default(now()) @updatedAt

  @@unique([schoolId, accessionNo])
  @@unique([schoolId, barcode])
  @@index([schoolId, titleId])
  @@index([schoolId, status])
}

model FacLibraryMember {
  id              String        @id @default(cuid())
  schoolId        String
  type            FacMemberType
  studentId       String?       @unique
  employeeId      String?       @unique
  suspended       Boolean       @default(false)
  suspendedReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([schoolId])
}

model FacLoan {
  id                String            @id @default(cuid())
  schoolId          String
  copyId            String
  memberId          String
  outAt             DateTime          @default(now())
  dueAt             DateTime
  returnedAt        DateTime?
  renewedCount      Int               @default(0)
  conditionOnReturn FacCopyCondition?
  fineCents         Int               @default(0)
  fineCurrency      Currency?
  // The Finance charge for the fine (Finance on), or the library ledger entry (Finance off).
  chargeId          String?
  ledgerEntryId     String?
  waivedById        String?
  waiveReason       String?
  checkedOutById    String
  returnedToId      String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@index([schoolId, copyId])
  @@index([schoolId, memberId])
  @@index([schoolId, returnedAt, dueAt])
}

model FacReservation {
  id          String    @id @default(cuid())
  schoolId    String
  titleId     String
  memberId    String
  reservedAt  DateTime  @default(now())
  notifiedAt  DateTime?
  fulfilledAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([schoolId, titleId])
  @@index([schoolId, memberId])
}

model FacTextbookSet {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  levelId   String?
  // [{ titleId, qty }]
  items     Json     @default("[]")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model FacTextbookIssue {
  id            String            @id @default(cuid())
  schoolId      String
  copyId        String
  studentId     String
  setId         String?
  yearId        String?
  issuedAt      DateTime          @default(now())
  issuedById    String
  conditionOut  FacCopyCondition?
  returnedAt    DateTime?
  returnedById  String?
  conditionIn   FacCopyCondition?
  // Marked when a leaver or the year-end return does not bring it back; it shows on the leaving clearance.
  missingAt     DateTime?
  chargeId      String?
  ledgerEntryId String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@index([schoolId, studentId])
  @@index([schoolId, copyId])
}

model FacStocktake {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  shelf       String?
  startedAt   DateTime  @default(now())
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([schoolId])
}

model FacStocktakeScan {
  id          String   @id @default(cuid())
  schoolId    String
  stocktakeId String
  copyId      String
  scannedAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@unique([stocktakeId, copyId])
  @@index([schoolId])
}

// ── Transport ───────────────────────────────────────────────────────────────

model FacRoute {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  zone      String?
  amTime    String?
  pmTime    String?
  vehicleId String?
  driverId  String?
  // Fee per term for the route or zone.
  feeCents  Int      @default(0)
  currency  Currency @default(USD)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model FacStop {
  id           String   @id @default(cuid())
  schoolId     String
  routeId      String
  name         String
  sequence     Int
  amPickupTime String?
  pmDropTime   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@unique([routeId, sequence])
  @@index([schoolId, routeId])
}

model FacStudentRoute {
  id            String    @id @default(cuid())
  schoolId      String
  studentId     String
  routeId       String
  amStopId      String
  pmStopId      String
  termId        String
  fromDate      DateTime  @db.Date
  // Removing a learner stops the charge from the next term; the row stays.
  removedAt     DateTime?
  chargeId      String?
  ledgerEntryId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@unique([studentId, termId])
  @@index([schoolId, routeId])
}

model FacVehicle {
  id           String          @id @default(cuid())
  schoolId     String
  registration String
  make         String
  model        String?
  seats        Int
  owner        FacVehicleOwner @default(SCHOOL)
  odometerKm   Int             @default(0)
  // The register entry for the vehicle, so its maintenance and cost sit with the asset.
  assetId      String?
  active       Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @default(now()) @updatedAt

  @@unique([schoolId, registration])
}

model FacVehicleDocument {
  id        String            @id @default(cuid())
  schoolId  String
  vehicleId String
  type      FacVehicleDocType
  number    String?
  expiry    DateTime          @db.Date
  fileKey   String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  @@index([schoolId, vehicleId])
  @@index([schoolId, expiry])
}

model FacDriver {
  id            String   @id @default(cuid())
  schoolId      String
  employeeId    String
  licenceClass  String
  licenceNumber String?
  phone         String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([schoolId, employeeId])
}

model FacDriverDocument {
  id        String           @id @default(cuid())
  schoolId  String
  driverId  String
  type      FacDriverDocType
  number    String?
  expiry    DateTime         @db.Date
  fileKey   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  @@index([schoolId, driverId])
  @@index([schoolId, expiry])
}

model FacTrip {
  id            String     @id @default(cuid())
  schoolId      String
  routeId       String?
  bookingId     String?
  vehicleId     String
  driverId      String
  date          DateTime   @db.Date
  leg           FacTripLeg @default(MORNING)
  odometerStart Int?
  odometerEnd   Int?
  departedAt    DateTime?
  arrivedAt     DateTime?
  recordedById  String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @default(now()) @updatedAt

  @@index([schoolId, vehicleId, date])
  @@index([schoolId, routeId, date])
}

model FacTripPassenger {
  id            String    @id @default(cuid())
  schoolId      String
  tripId        String?
  bookingId     String?
  studentId     String
  boardedAt     DateTime?
  // A school trip can be billed to the learners going.
  chargeId      String?
  ledgerEntryId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([schoolId, tripId])
  @@index([schoolId, bookingId])
}

model FacFuelLog {
  id           String   @id @default(cuid())
  schoolId     String
  vehicleId    String
  tripId       String?
  date         DateTime @db.Date
  litres       Float
  costCents    Int
  currency     Currency
  receiptKey   String?
  odometerKm   Int?
  // The Finance expense this created (Finance on).
  expenseId    String?
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  @@index([schoolId, vehicleId, date])
}

model FacVehicleBooking {
  id              String      @id @default(cuid())
  schoolId        String
  vehicleId       String
  driverId        String?
  startAt         DateTime
  endAt           DateTime
  purpose         String
  destination     String?
  // Charge per learner going (billed to them), in cents.
  perLearnerCents Int?
  currency        Currency?
  status          FacApproval @default(PENDING)
  requestedById   String
  approvedById    String?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @default(now()) @updatedAt

  @@index([schoolId, vehicleId, startAt])
}

// ── Inventory and stores ────────────────────────────────────────────────────

model FacStore {
  id            String   @id @default(cuid())
  schoolId      String
  name          String
  storekeeperId String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model FacStockItem {
  id            String           @id @default(cuid())
  schoolId      String
  name          String
  category      FacStockCategory
  unit          FacStockUnit     @default(EACH)
  size          String?
  gender        Gender?
  barcode       String?
  reorderLevel  Int              @default(0)
  // Selling price when the item is sold to learners or at the tuck shop.
  priceCents    Int?
  priceCurrency Currency?
  tracksExpiry  Boolean          @default(false)
  active        Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt

  @@index([schoolId, category])
  @@index([schoolId, barcode])
}

model FacStockLot {
  id        String    @id @default(cuid())
  schoolId  String
  itemId    String
  storeId   String
  expiry    DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([schoolId, itemId, storeId])
  @@index([schoolId, expiry])
}

// Stock on hand is the sum of these rows per item and store. Plus for goods in, minus for goods out.
model FacStockMovement {
  id                 String             @id @default(cuid())
  schoolId           String
  itemId             String
  storeId            String
  lotId              String?
  type               FacMovementType
  qty                Float
  unitCostCents      Int                @default(0)
  currency           Currency           @default(USD)
  purchaseRequestId  String?
  // The line of the purchase request this delivery fills in.
  requestItemId      String?
  deliveryNote       String?
  photoKey           String?
  // Required for donations, opening stock, adjustments and write-offs.
  reason             String?
  writeoffReason     FacWriteoffReason?
  shortfallNote      String?
  // The other side of a transfer.
  transferGroupId    String?
  receiverName       String?
  receiverEmployeeId String?
  department         String?
  signatureKey       String?
  studentId          String?
  chargeId           String?
  ledgerEntryId      String?
  countId            String?
  approvedById       String?
  approvedAt         DateTime?
  createdById        String
  createdAt          DateTime           @default(now())

  @@index([schoolId, itemId, storeId])
  @@index([schoolId, type, createdAt])
  @@index([schoolId, purchaseRequestId])
}

model FacStockCount {
  id            String         @id @default(cuid())
  schoolId      String
  storeId       String
  status        FacCountStatus @default(OPEN)
  countedAt     DateTime       @default(now())
  createdById   String
  submittedAt   DateTime?
  submittedById String?
  // Set when the value of the differences is above the school's limit: the Head approves before they are posted.
  needsApproval Boolean        @default(false)
  approvedById  String?
  approvedAt    DateTime?
  closedAt      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt

  @@index([schoolId, storeId])
}

model FacStockCountLine {
  id          String   @id @default(cuid())
  schoolId    String
  countId     String
  itemId      String
  lotId       String?
  // What the system said was there when the sheet was made.
  expectedQty Float
  countedQty  Float?
  movementId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@unique([countId, itemId, lotId])
  @@index([schoolId, countId])
}

// ── Assets and maintenance ──────────────────────────────────────────────────

model FacAssetCategory {
  id                String   @id @default(cuid())
  schoolId          String
  name              String
  // Straight-line depreciation; none when null.
  depreciationYears Int?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([schoolId, name])
}

model FacAsset {
  id            String            @id @default(cuid())
  schoolId      String
  tag           String
  name          String
  categoryId    String
  location      String
  custodianId   String?
  costCents     Int               @default(0)
  currency      Currency          @default(USD)
  purchasedAt   DateTime?         @db.Date
  supplierId    String?
  requestId     String?
  requestItemId String?
  expenseId     String?
  condition     FacAssetCondition @default(GOOD)
  status        FacAssetStatus    @default(IN_USE)
  serial        String?
  warrantyEnd   DateTime?         @db.Date
  photoKey      String?
  notes         String?
  legacyAssetId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@unique([schoolId, tag])
  @@index([schoolId, status])
  @@index([schoolId, location])
  @@index([schoolId, custodianId])
}

model FacAssetTransfer {
  id              String    @id @default(cuid())
  schoolId        String
  assetId         String
  fromLocation    String
  toLocation      String
  fromCustodianId String?
  toCustodianId   String?
  date            DateTime  @db.Date
  recordedById    String
  confirmedAt     DateTime?
  confirmedById   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([schoolId, assetId])
}

model FacMaintenanceSchedule {
  id               String    @id @default(cuid())
  schoolId         String
  assetId          String
  title            String
  everyMonths      Int?
  everyKm          Int?
  remindDaysBefore Int       @default(14)
  lastDoneAt       DateTime? @db.Date
  lastDoneKm       Int?
  nextDueAt        DateTime? @db.Date
  nextDueKm        Int?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([schoolId, assetId])
  @@index([schoolId, nextDueAt])
}

model FacMaintenanceJob {
  id              String       @id @default(cuid())
  schoolId        String
  assetId         String
  scheduleId      String?
  problem         String
  photoKey        String?
  reportedById    String
  assignedToId    String?
  status          FacJobStatus @default(REPORTED)
  workDone        String?
  provider        String?
  costCents       Int?
  currency        Currency?
  // The Finance expense for the work (Finance on).
  expenseId       String?
  doneAt          DateTime?
  nextServiceDate DateTime?    @db.Date
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @default(now()) @updatedAt

  @@index([schoolId, assetId])
  @@index([schoolId, status])
}

// One disposal per asset, ever.
model FacAssetDisposal {
  id                String            @id @default(cuid())
  schoolId          String
  assetId           String            @unique
  method            FacDisposalMethod
  reason            String
  date              DateTime          @db.Date
  proceedsCents     Int?
  currency          Currency?
  headApprovedById  String
  ownerApprovedById String?
  // The Finance income recorded for the money received.
  incomeRef         String?
  recordedById      String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt
}

model FacVerificationRound {
  id          String    @id @default(cuid())
  schoolId    String
  name        String
  startedAt   DateTime  @default(now())
  closedAt    DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([schoolId])
}

model FacVerificationScan {
  id              String        @id @default(cuid())
  schoolId        String
  roundId         String
  assetId         String
  scannedLocation String
  result          FacScanResult
  scannedById     String
  scannedAt       DateTime      @default(now())
  createdAt       DateTime      @default(now())

  @@unique([roundId, assetId])
  @@index([schoolId])
}

// A stock write-off waits here until someone with the write-off permission (not the person who asked) approves it; only then is the
// WRITEOFF movement made.
model FacWriteoffRequest {
  id             String            @id @default(cuid())
  schoolId       String
  storeId        String
  itemId         String
  lotId          String?
  qty            Float
  writeoffReason FacWriteoffReason
  reason         String
  status         FacApproval       @default(PENDING)
  requestedById  String
  decidedById    String?
  decidedAt      DateTime?
  decisionReason String?
  movementId     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @default(now()) @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, storeId])
}

// A disposal waits here until the Head approves it (and the Owner too, above the school's value limit); only then is the asset's one
// disposal made. Nothing is deleted: a refused request stays.
model FacDisposalRequest {
  id                String            @id @default(cuid())
  schoolId          String
  assetId           String
  method            FacDisposalMethod
  reason            String
  date              DateTime          @db.Date
  proceedsCents     Int?
  currency          Currency?
  // What the asset cost, to decide whether the Owner must approve too.
  valueCents        Int
  valueCurrency     Currency
  needsOwner        Boolean           @default(false)
  status            FacApproval       @default(PENDING)
  requestedById     String
  headApprovedById  String?
  headApprovedAt    DateTime?
  ownerApprovedById String?
  ownerApprovedAt   DateTime?
  rejectedById      String?
  rejectedAt        DateTime?
  rejectionReason   String?
  disposalId        String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, assetId])
}
