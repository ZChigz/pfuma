  commentBank               CommentBankItem[]
  examSettings              ExamSettings?
  examDeadlines             ExamDeadline[]
  examDepartmentVerifiers   ExamDepartmentVerifier[]
  examPeriods               ExamPeriod[]
  examPeriodLevels          ExamPeriodLevel[]
  examPapers                ExamPaper[]
  examPaperRooms            ExamPaperRoom[]
  invigilations             Invigilation[]
  examAttendance            ExamAttendance[]
  examIncidents             ExamIncident[]
