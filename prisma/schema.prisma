generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DIRECTOR
  HEAD
  BURSAR
  TEACHER
  LIBRARIAN
}

enum Currency {
  USD
  ZIG
}

enum PaymentMethod {
  CASH
  ECOCASH
  SWIPE
  ZIPIT
}

enum PaymentStatus {
  PENDING
  VERIFIED
  VOIDED
}

enum ExpenseStatus {
  ACTIVE
  VOIDED
}

enum RequestStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

enum ExpenseRequestType {
  PURCHASE_ORDER
  UTILITY_BILL
  FUEL
  SALARY_ADVANCE
  MAINTENANCE
  OTHER
}

enum Gender {
  M
  F
}

enum StudentStatus {
  ACTIVE
  TRANSFERRED
  SUSPENDED
  GRADUATED
  WITHDRAWN
}

enum LevelCategory {
  O_LEVEL
  A_LEVEL
}

enum TermStatus {
  PLANNED
  OPEN
  CLOSED
}

// How a student's time in a class for one term ended. ACTIVE means the
// enrollment is current, or (when endDate is set) the term finished normally
// and the student carried on in the next term.
enum EnrollmentStatus {
  ACTIVE
  PROMOTED
  REPEATED
  TRANSFERRED_OUT
  WITHDRAWN
  GRADUATED
}

enum GuardianRelationship {
  FATHER
  MOTHER
  UNCLE
  AUNT
  GRANDPARENT
  SIBLING
  GUARDIAN
  OTHER
}

enum SubjectType {
  CORE
  ELECTIVE
}

// DRAFT / VERIFIED / PUBLISHED are the workflow of a score. ABSENT and EXEMPT are
// entered by the teacher instead of a score: ABSENT counts as 0 unless the Head
// excuses it, EXEMPT is left out of the student's subjects.
enum MarkStatus {
  DRAFT
  VERIFIED
  PUBLISHED
  ABSENT
  EXEMPT
}

// How O Level classes are ranked.
enum RankingMode {
  AVERAGE
  PASSES_THEN_AVERAGE
}

enum AssignmentMarkStatus {
  NOT_STARTED
  IN_PROGRESS
  VERIFIED
  PUBLISHED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  CONDEMNED
}

enum AssetStatus {
  ACTIVE
  UNDER_MAINTENANCE
  DISPOSED
}

enum DisposalMethod {
  SOLD
  SCRAPPED
  DONATED
}

enum CopyCondition {
  NEW
  GOOD
  FAIR
  DAMAGED
}

enum CopyStatus {
  AVAILABLE
  BORROWED
  LOST
  DAMAGED // in the library but not lendable until repaired
  WITHDRAWN // taken out of circulation
}

// Where an exchange rate came from.
enum RateSource {
  RBZ
  SCHOOL
  OTHER
}

enum IncomeSource {
  ASSET_DISPOSAL
  OTHER
}

enum MemberType {
  STAFF
  STUDENT
}

enum AuditAction {
  RECORD_PAYMENT
  VERIFY_PAYMENT
  VOID_PAYMENT
  RECORD_EXPENSE
  VOID_EXPENSE
  APPLY_CHARGE
  CREATE_STUDENT
  UPDATE_STUDENT
  RECORD_MARK
  VERIFY_MARKS
  UNVERIFY_MARKS
  PUBLISH_RESULTS
  CREATE_ASSET
  UPDATE_ASSET
  DISPOSE_ASSET
  CHECKOUT_BOOK
  RETURN_BOOK
  CREATE_USER
  UPDATE_USER
  RESET_PASSWORD
  CREATE_CLASS
  UPDATE_CLASS
  MOVE_STUDENT
  BULK_APPLY_FEES
  CREATE_FEE_STRUCTURE
  UPDATE_FEE_STRUCTURE
  CREATE_EXPENSE_REQUEST
  SUBMIT_EXPENSE_REQUEST
  APPROVE_EXPENSE_REQUEST
  REJECT_EXPENSE_REQUEST
  DISBURSE_EXPENSE_REQUEST
  UPDATE_SCHOOL_SETTINGS
  CREATE_ACADEMIC_YEAR
  UPDATE_ACADEMIC_TERM
  OPEN_TERM
  CLOSE_TERM
  ADMIT_STUDENT
  TRANSFER_CLASS
  PROMOTE_STUDENT
  REPEAT_STUDENT
  TRANSFER_OUT_STUDENT
  WITHDRAW_STUDENT
  GRADUATE_STUDENT
  CREATE_GUARDIAN
  UPDATE_GUARDIAN
  LINK_GUARDIAN
  UNLINK_GUARDIAN
  SET_PRIMARY_GUARDIAN
  DATA_CREATE
  DATA_UPDATE
  DATA_DELETE
  LOGIN_FAILED
  LOGIN_LOCKED
  LOGOUT_ALL_SESSIONS
  CHANGE_PASSWORD
  REGENERATE_PORTAL_LINK
  SET_PORTAL_PIN
  VOID_WITHOUT_SECOND_APPROVER
  UNPUBLISH_RESULTS
  REOPEN_TERM
  CHANGE_MARK
  EXCUSE_ABSENCE
  UPDATE_GRADE_BOUNDARIES
  UPDATE_REPORT_CARD
  CREATE_LIBRARY_MEMBER
  SUSPEND_LIBRARY_MEMBER
  UPDATE_BOOK_COPY
  SETTLE_LIBRARY_FINE
  UPDATE_LIBRARY_SETTINGS
  SET_EXCHANGE_RATE
  TRANSFER_ASSET
  RECORD_INCOME
  CREATE_PASSWORD_RESET
  USE_PASSWORD_RESET
  DEACTIVATE_USER
  REACTIVATE_USER
  UPDATE_SCHOOL_MODULES
  CREATE_CALENDAR_EVENT
  UPDATE_CALENDAR_EVENT
  DELETE_CALENDAR_EVENT
}

enum SchoolType {
  GOVERNMENT
  PRIVATE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CalendarEventKind {
  HOLIDAY
  EXAM
  SPORTS
  MEETING
  OTHER
}

// ─── Core ────────────────────────────────────────────────────────────────────

model School {
  id               String      @id @default(cuid())
  name             String
  location         String?
  // Default capacity for newly created classes.
  maxClassSize     Int         @default(45)
  // Lowest grade that counts as a pass ("C or better" = C), looked up in GradeBoundary.
  passGrade        String      @default("C")
  // O Level classes: rank by average percentage, or by number of passes then average.
  oLevelRanking    RankingMode @default(AVERAGE)
  // Library: checkout is blocked above this much unpaid fines (in the fine currency),
  // and each kind of member has its own loan limit.
  libraryFineLimit Decimal     @default(5) @db.Decimal(14, 2)
  studentLoanLimit Int         @default(2)
  staffLoanLimit   Int         @default(5)
  // Profile shown in the top bar and on documents.
  schoolType       SchoolType  @default(GOVERNMENT)
  phone            String?
  email            String?
  address          String?
  motto            String?
  logoUrl          String?
  defaultCurrency  Currency    @default(USD)
  province         String?
  // ZIMSEC examination centre number.
  zimsecCentreNumber String?
  // Receipt numbers look like <prefix>-<number>; a null prefix means not chosen yet.
  receiptPrefix      String?
  receiptNextNumber  Int @default(1)
  // Keeps the dashboard setup checklist visible after every step is done.
  setupChecklistPinned Boolean @default(false)
  createdAt        DateTime    @default(now())
  // Legacy column "currentTerm" still exists in the database until the
  // contract migration; the current term is now the OPEN AcademicTerm.

  levels        Level[]
  academicYears AcademicYear[]
  academicTerms AcademicTerm[]
  enrollments   Enrollment[]
  guardians     Guardian[]

  users               User[]
  students            Student[]
  feeStructures       FeeStructure[]
  charges             Charge[]
  payments            Payment[]
  expenses            Expense[]
  expenseRequests     ExpenseRequest[]
  auditLogs           AuditLog[]
  subjects            Subject[]
  subjectAssignments  SubjectAssignment[]
  marks               Mark[]
  markChanges         MarkChange[]
  termResults         TermResult[]
  gradeBoundaries     GradeBoundary[]
  assetCategories     AssetCategory[]
  assets              Asset[]
  assetMaintenances   AssetMaintenance[]
  assetDisposals      AssetDisposal[]
  books               Book[]
  bookCopies          BookCopy[]
  libraryMembers      LibraryMember[]
  borrowings          Borrowing[]
  exchangeRates       ExchangeRate[]
  schoolClasses       SchoolClass[]
  passwordResetTokens PasswordResetToken[]
  assetTransfers      AssetTransfer[]
  incomes             Income[]
  subscription        Subscription?
  modules             SchoolModule[]
  rolePermissions     RolePermission[]
  notifications       Notification[]
  calendarEvents      CalendarEvent[]
}

model User {
  id                 String    @id @default(cuid())
  schoolId           String
  fullName           String
  email              String
  passwordHash       String
  role               Role      @default(TEACHER)
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now())
  // Bumped when the user is deactivated, changes role or school, resets their
  // password, or an ADMIN logs everyone out. A JWT carrying an older value is
  // rejected (lib/auth.ts).
  tokenVersion       Int       @default(0)
  // True for accounts created or reset by an admin until the user picks their own password.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?

  school School @relation(fields: [schoolId], references: [id])

  recordedPayments    Payment[]           @relation("RecordedPayments")
  verifiedPayments    Payment[]           @relation("VerifiedPayments")
  voidedPayments      Payment[]           @relation("VoidedPayments")
  recordedExpenses    Expense[]           @relation("RecordedExpenses")
  voidedExpenses      Expense[]           @relation("VoidedExpenses")
  requestedExpenses   ExpenseRequest[]    @relation("RequestedExpenses")
  approvedExpenses    ExpenseRequest[]    @relation("ApprovedExpenses")
  rejectedExpenses    ExpenseRequest[]    @relation("RejectedExpenses")
  disbursedExpenses   ExpenseRequest[]    @relation("DisbursedExpenses")
  auditLogs           AuditLog[]
  subjectAssignments  SubjectAssignment[]
  verifiedAssignments SubjectAssignment[] @relation("VerifiedAssignments")
  marks               Mark[]
  markChanges         MarkChange[]
  assetMaintenances   AssetMaintenance[]
  assetDisposals      AssetDisposal[]
  libraryMember       LibraryMember?
  classesTaught       SchoolClass[]
  closedTerms         AcademicTerm[]      @relation("ClosedTerms")

  exchangeRates         ExchangeRate[]
  resetTokens           PasswordResetToken[] @relation("ResetTokenUser")
  resetTokensCreated    PasswordResetToken[] @relation("ResetTokenCreator")
  custodianOf           Asset[]              @relation("AssetCustodian")
  transfersFrom         AssetTransfer[]      @relation("TransferFrom")
  transfersTo           AssetTransfer[]      @relation("TransferTo")
  transfersRecorded     AssetTransfer[]      @relation("TransfersRecorded")
  incomeRecorded        Income[]
  notifications         Notification[]
  calendarEventsCreated CalendarEvent[]

  @@unique([schoolId, email])
  @@index([schoolId])
}

// ─── Classes ─────────────────────────────────────────────────────────────────

model SchoolClass {
  id             String   @id @default(cuid())
  schoolId       String
  name           String
  levelId        String
  stream         String // e.g. "North"; "" for a level with a single class
  capacity       Int      @default(45)
  classTeacherId String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  // Legacy columns "grade" and "section" remain in the database until the
  // contract migration and are no longer read or written.

  school          School              @relation(fields: [schoolId], references: [id])
  level           Level               @relation(fields: [levelId], references: [id])
  classTeacher    User?               @relation(fields: [classTeacherId], references: [id])
  currentStudents Student[]           @relation("CurrentClass")
  enrollments     Enrollment[]
  assignments     SubjectAssignment[]

  @@unique([schoolId, name])
  @@unique([schoolId, levelId, stream])
  @@index([schoolId])
}

// ─── Academic structure ──────────────────────────────────────────────────────

model Level {
  id       String        @id @default(cuid())
  schoolId String
  name     String // "Form 1" … "Form 6"
  order    Int // 1–6: sorting and promotion
  category LevelCategory

  school          School          @relation(fields: [schoolId], references: [id])
  classes         SchoolClass[]
  feeStructures   FeeStructure[]
  gradeBoundaries GradeBoundary[]

  @@unique([schoolId, name])
  @@unique([schoolId, order])
  @@index([schoolId])
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  createdAt DateTime @default(now())

  school School         @relation(fields: [schoolId], references: [id])
  terms  AcademicTerm[]

  @@unique([schoolId, year])
  @@index([schoolId])
}

// At most one OPEN term per school: enforced in lib/academic/terms.ts and by the
// partial unique index "AcademicTerm_one_open_per_school" (created in SQL;
// Prisma cannot express partial indexes, so keep it when writing migrations).
model AcademicTerm {
  id             String     @id @default(cuid())
  schoolId       String
  academicYearId String
  termNumber     Int // 1–3
  name           String // "Term 1 2026"
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  status         TermStatus @default(PLANNED)
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime   @default(now())

  school             School              @relation(fields: [schoolId], references: [id])
  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  closedBy           User?               @relation("ClosedTerms", fields: [closedById], references: [id])
  feeStructures      FeeStructure[]
  charges            Charge[]
  subjectAssignments SubjectAssignment[]
  marks              Mark[]
  termResults        TermResult[]
  enrollments        Enrollment[]
  gradeBoundaries    GradeBoundary[]

  @@unique([academicYearId, termNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

// Class history: exactly one class per student per term.
model Enrollment {
  id        String           @id @default(cuid())
  schoolId  String
  studentId String
  classId   String
  termId    String
  status    EnrollmentStatus @default(ACTIVE)
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime         @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  class   SchoolClass  @relation(fields: [classId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([schoolId])
  @@index([termId, classId])
}

// ─── Students & guardians ────────────────────────────────────────────────────

model Student {
  id                     String        @id @default(cuid())
  schoolId               String
  admissionNumber        String // STU + admission year + 4-digit sequence
  firstName              String
  surname                String
  fullName               String // firstName + surname, kept for display and search
  gender                 Gender? // required for new students; null for some legacy rows
  dateOfBirth            DateTime?     @db.Date
  birthCertificateNumber String?
  admissionDate          DateTime      @db.Date
  previousSchool         String?
  medicalNotes           String?
  photoUrl               String?
  status                 StudentStatus @default(ACTIVE)
  // Cache of the class in the OPEN term's Enrollment; updated in the same
  // transaction as the Enrollment. Never the source of truth.
  currentClassId         String?
  houseNumber            String?
  suburb                 String?
  city                   String?
  address                String?
  // Legacy plaintext link token. Emptied by migration 20261017000100 and no
  // longer read or written; dropped by the contract migration.
  portalToken            String?       @unique
  // SHA-256 (hex) of the parent-portal link token. The token itself is shown
  // once when generated and never stored.
  portalTokenHash        String?       @unique
  portalTokenCreatedAt   DateTime?
  portalTokenExpiresAt   DateTime?
  // bcrypt hash of the optional 4-digit portal PIN.
  portalPinHash          String?
  createdAt              DateTime      @default(now())
  // Legacy columns "grade", "classId", "parentName", "parentPhone", "active",
  // "studentNumber", "enrollmentYear", "guardianRelationship" and
  // "secondGuardianPhone" remain in the database until the contract migration.

  school        School            @relation(fields: [schoolId], references: [id])
  currentClass  SchoolClass?      @relation("CurrentClass", fields: [currentClassId], references: [id])
  enrollments   Enrollment[]
  guardians     StudentGuardian[]
  charges       Charge[]
  payments      Payment[]
  marks         Mark[]
  termResults   TermResult[]
  portalViews   PortalAccessLog[]
  libraryMember LibraryMember?

  @@unique([schoolId, admissionNumber])
  @@unique([schoolId, birthCertificateNumber])
  @@index([schoolId])
  @@index([schoolId, currentClassId])
  @@index([schoolId, surname, firstName])
}

model Guardian {
  id         String   @id @default(cuid())
  schoolId   String
  fullName   String
  phone      String // +263XXXXXXXXX (legacy rows that could not be normalised keep their original text)
  altPhone   String?
  email      String?
  nationalId String?
  address    String?
  occupation String?
  createdAt  DateTime @default(now())

  school   School            @relation(fields: [schoolId], references: [id])
  students StudentGuardian[]

  @@index([schoolId])
  @@index([schoolId, phone])
}

// One primary guardian per student: at most one is enforced by the partial
// unique index "StudentGuardian_one_primary_per_student" (SQL only); at least
// one is enforced in lib/students/guardians.ts.
model StudentGuardian {
  studentId        String
  guardianId       String
  relationship     GuardianRelationship
  relationshipNote String? // free text when relationship is OTHER
  isPrimary        Boolean              @default(false)
  isFeePayer       Boolean              @default(false)
  canReceiveSms    Boolean              @default(true)
  createdAt        DateTime             @default(now())

  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@id([studentId, guardianId])
  @@index([guardianId])
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model FeeStructure {
  id        String   @id @default(cuid())
  schoolId  String
  levelId   String? // null = applies to every level
  termId    String
  label     String
  currency  Currency
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())

  school School       @relation(fields: [schoolId], references: [id])
  level  Level?       @relation(fields: [levelId], references: [id])
  term   AcademicTerm @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([termId])
}

model Charge {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  termId    String
  label     String
  currency  Currency
  amount    Decimal  @db.Decimal(14, 2)
  issuedAt  DateTime @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([schoolId, studentId])
  @@index([termId])
}

model Payment {
  id               String        @id @default(cuid())
  schoolId         String
  studentId        String
  currency         Currency
  amount           Decimal       @db.Decimal(14, 2)
  method           PaymentMethod
  reference        String?
  feeLabel         String
  status           PaymentStatus @default(PENDING)
  popUrl           String? // legacy public URL of an old proof of payment
  // Private proof-of-payment upload (UploadThing custom id "pop:<schoolId>:…");
  // served only through short-lived signed URLs.
  popKey           String?
  recordedBy       String
  verifiedBy       String?
  voidedBy         String?
  recordedAt       DateTime      @default(now())
  verifiedAt       DateTime?
  voidedAt         DateTime?
  paidInZig        Boolean       @default(false)
  zigAmountPaid    Decimal?      @db.Decimal(14, 2)
  exchangeRateUsed Decimal?      @db.Decimal(14, 2)
  // The exact rate row used for a ZiG payment.
  exchangeRateId   String?

  school       School        @relation(fields: [schoolId], references: [id])
  student      Student       @relation(fields: [studentId], references: [id])
  recorder     User          @relation("RecordedPayments", fields: [recordedBy], references: [id])
  verifier     User?         @relation("VerifiedPayments", fields: [verifiedBy], references: [id])
  voider       User?         @relation("VoidedPayments", fields: [voidedBy], references: [id])
  exchangeRate ExchangeRate? @relation(fields: [exchangeRateId], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([schoolId, studentId])
}

model Expense {
  id         String        @id @default(cuid())
  schoolId   String
  category   String
  currency   Currency
  amount     Decimal       @db.Decimal(14, 2)
  note       String?
  spentOn    DateTime
  recordedBy String
  status     ExpenseStatus @default(ACTIVE)
  voidedBy   String?
  createdAt  DateTime      @default(now())

  expenseRequestId String?         @unique
  expenseRequest   ExpenseRequest? @relation(fields: [expenseRequestId], references: [id])

  school   School @relation(fields: [schoolId], references: [id])
  recorder User   @relation("RecordedExpenses", fields: [recordedBy], references: [id])
  voider   User?  @relation("VoidedExpenses", fields: [voidedBy], references: [id])

  @@index([schoolId])
  @@index([schoolId, status])
}

model ExpenseRequest {
  id             String             @id @default(cuid())
  schoolId       String
  school         School             @relation(fields: [schoolId], references: [id])
  requestNumber  String
  title          String
  type           ExpenseRequestType
  department     String
  justification  String
  currency       Currency
  estimatedTotal Decimal            @db.Decimal(14, 2)
  actualTotal    Decimal?           @db.Decimal(14, 2)

  status RequestStatus @default(DRAFT)

  requestedById String
  requestedBy   User     @relation("RequestedExpenses", fields: [requestedById], references: [id])
  requestedAt   DateTime @default(now())

  approvedById String?
  approvedBy   User?     @relation("ApprovedExpenses", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  rejectedById    String?
  rejectedBy      User?     @relation("RejectedExpenses", fields: [rejectedById], references: [id])
  rejectedAt      DateTime?
  rejectionReason String?

  disbursedById    String?
  disbursedBy      User?          @relation("DisbursedExpenses", fields: [disbursedById], references: [id])
  disbursedAt      DateTime?
  disbursementNote String?
  paymentMethod    PaymentMethod?

  items   ExpenseRequestItem[]
  expense Expense?

  createdAt DateTime @default(now())

  @@index([schoolId])
  @@index([schoolId, status])
  @@index([requestedById])
}

model ExpenseRequestItem {
  id          String         @id @default(cuid())
  requestId   String
  request     ExpenseRequest @relation(fields: [requestId], references: [id])
  description String
  quantity    Int            @default(1)
  unitPrice   Decimal        @db.Decimal(14, 2)
  total       Decimal        @db.Decimal(14, 2)

  @@index([requestId])
}

model AuditLog {
  id         String      @id @default(cuid())
  schoolId   String
  actorId    String
  action     AuditAction
  entityType String
  entityId   String
  detail     String?
  // Row values before and after a DATA_CREATE / DATA_UPDATE / DATA_DELETE,
  // written by the database trigger "audit_row_change" (secrets removed).
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([schoolId])
  @@index([schoolId, entityType, entityId])
}

// One row per view of a student's parent-portal page.
model PortalAccessLog {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  ip        String
  userAgent String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id])

  @@index([schoolId])
  @@index([studentId, createdAt])
}

// ─── Results ─────────────────────────────────────────────────────────────────

model Subject {
  id       String      @id @default(cuid())
  schoolId String
  name     String
  code     String
  maxMark  Int         @default(100)
  type     SubjectType @default(CORE)
  active   Boolean     @default(true)

  school      School              @relation(fields: [schoolId], references: [id])
  assignments SubjectAssignment[]
  marks       Mark[]

  @@unique([schoolId, code])
  @@index([schoolId])
}

model SubjectAssignment {
  id        String       @id @default(cuid())
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id])
  teacherId String
  teacher   User         @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id])
  classId   String
  class     SchoolClass  @relation(fields: [classId], references: [id])
  termId    String
  term      AcademicTerm @relation(fields: [termId], references: [id])
  createdAt DateTime     @default(now())

  marksStatus       AssignmentMarkStatus @default(NOT_STARTED)
  marksVerifiedAt   DateTime?
  marksVerifiedById String?
  marksVerifiedBy   User?                @relation("VerifiedAssignments", fields: [marksVerifiedById], references: [id])

  @@unique([subjectId, classId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([teacherId, schoolId])
}

model Mark {
  id              String     @id @default(cuid())
  schoolId        String
  studentId       String
  subjectId       String
  termId          String
  rawMark         Decimal    @db.Decimal(14, 2)
  percentage      Decimal?   @db.Decimal(14, 2)
  letterGrade     String?
  status          MarkStatus @default(DRAFT)
  verifiedAt      DateTime?
  // Set the first time the mark is verified and never cleared: any change after
  // this moment needs a reason and is recorded in MarkChange.
  firstVerifiedAt DateTime?
  // Why the student was absent (status ABSENT), and whether the Head excused it.
  absenceReason   String?
  excused         Boolean    @default(false)
  // The boundary the letter grade came from, copied when the mark is entered and
  // again when the class is published, so later boundary edits never change a
  // published grade.
  gradeMinPercent Decimal?   @db.Decimal(14, 2)
  gradeMaxPercent Decimal?   @db.Decimal(14, 2)
  enteredBy       String
  enteredAt       DateTime   @default(now())

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  subject Subject      @relation(fields: [subjectId], references: [id])
  enterer User         @relation(fields: [enteredBy], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])
  changes MarkChange[]

  @@unique([studentId, subjectId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([schoolId, studentId])
}

// History of every change to a mark after it was first verified.
model MarkChange {
  id          String   @id @default(cuid())
  schoolId    String
  markId      String
  oldRawMark  Decimal  @db.Decimal(14, 2)
  newRawMark  Decimal  @db.Decimal(14, 2)
  changedById String
  reason      String
  changedAt   DateTime @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  mark      Mark   @relation(fields: [markId], references: [id])
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([schoolId])
  @@index([markId])
}

model TermResult {
  id                 String    @id @default(cuid())
  schoolId           String
  studentId          String
  termId             String
  totalMarks         Decimal   @db.Decimal(14, 2)
  percentage         Decimal   @db.Decimal(14, 2)
  classPosition      Int?
  // Fair ranking (Part 4): how many of the class's subjects the student sat,
  // how many were offered, and how many students were ranked in the class.
  // classPosition is null when the student sat too few subjects to be ranked.
  subjectsSat        Int?
  subjectsOffered    Int?
  rankedOutOf        Int?
  // 4.3: subjects counted (EXEMPT and excused absences left out), their average
  // percentage, and how many reached the school's pass grade. subjectsSat and
  // percentage are older copies of subjectsTaken and averagePercentage.
  subjectsTaken      Int?
  averagePercentage  Decimal?  @db.Decimal(14, 2)
  subjectsPassed     Int?
  // 4.4 / 4.6: students in the class ("Position 2 of 42"), the overall grade as
  // published, and the report-card extras.
  classSize          Int?
  letterGrade        String?
  classTeacherRemark String?
  daysPresent        Int?
  daysAbsent         Int?
  nextTermStartDate  DateTime? @db.Date
  headRemark         String?
  published          Boolean   @default(false)
  publishedAt        DateTime?

  school  School       @relation(fields: [schoolId], references: [id])
  student Student      @relation(fields: [studentId], references: [id])
  term    AcademicTerm @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
  @@index([termId])
  @@index([schoolId])
  @@index([schoolId, studentId])
}

// A set of boundaries is all rows sharing the same (levelId, termId). The most
// specific set wins: level + term, then level, then term, then the school-wide set
// (both null). This lets O Level and A Level use different boundaries.
model GradeBoundary {
  id          String  @id @default(cuid())
  schoolId    String
  levelId     String?
  termId      String?
  minPercent  Decimal @db.Decimal(14, 2)
  maxPercent  Decimal @db.Decimal(14, 2)
  letterGrade String

  school School        @relation(fields: [schoolId], references: [id])
  level  Level?        @relation(fields: [levelId], references: [id])
  term   AcademicTerm? @relation(fields: [termId], references: [id])

  @@index([schoolId])
  @@index([schoolId, levelId, termId])
}

// ─── Assets ──────────────────────────────────────────────────────────────────

model AssetCategory {
  id       String @id @default(cuid())
  schoolId String
  name     String

  school School  @relation(fields: [schoolId], references: [id])
  assets Asset[]

  @@index([schoolId])
}

model Asset {
  id              String         @id @default(cuid())
  schoolId        String
  name            String
  categoryId      String
  description     String?
  tagNumber       String
  acquisitionDate DateTime
  acquisitionCost Decimal        @db.Decimal(14, 2)
  currency        Currency
  location        String
  // Who looks after it: a staff member (custodianId) or, for anyone else, a name.
  custodian       String?
  custodianId     String?
  condition       AssetCondition @default(GOOD)
  status          AssetStatus    @default(ACTIVE)
  imageUrl        String?
  createdAt       DateTime       @default(now())

  school        School             @relation(fields: [schoolId], references: [id])
  category      AssetCategory      @relation(fields: [categoryId], references: [id])
  maintenance   AssetMaintenance[]
  disposal      AssetDisposal?
  custodianUser User?              @relation("AssetCustodian", fields: [custodianId], references: [id])
  transfers     AssetTransfer[]

  @@unique([schoolId, tagNumber])
  @@index([schoolId])
  @@index([schoolId, status])
}

// Every change of an asset's location or custodian, kept for good (append-only).
model AssetTransfer {
  id                String   @id @default(cuid())
  schoolId          String
  assetId           String
  fromLocation      String
  toLocation        String
  fromCustodianId   String?
  toCustodianId     String?
  fromCustodianName String?
  toCustodianName   String?
  transferDate      DateTime
  note              String?
  recordedById      String
  createdAt         DateTime @default(now())

  school        School @relation(fields: [schoolId], references: [id])
  asset         Asset  @relation(fields: [assetId], references: [id])
  fromCustodian User?  @relation("TransferFrom", fields: [fromCustodianId], references: [id])
  toCustodian   User?  @relation("TransferTo", fields: [toCustodianId], references: [id])
  recordedBy    User   @relation("TransfersRecorded", fields: [recordedById], references: [id])

  @@index([schoolId])
  @@index([assetId, transferDate])
}

// Money the school receives that is not a student payment (e.g. selling a disposed asset).
// Finance reports add it to the net position.
model Income {
  id              String       @id @default(cuid())
  schoolId        String
  source          IncomeSource
  amount          Decimal      @db.Decimal(14, 2)
  currency        Currency
  receivedOn      DateTime
  description     String
  assetDisposalId String?      @unique
  recordedById    String
  createdAt       DateTime     @default(now())

  school     School         @relation(fields: [schoolId], references: [id])
  disposal   AssetDisposal? @relation(fields: [assetDisposalId], references: [id])
  recordedBy User           @relation(fields: [recordedById], references: [id])

  @@index([schoolId])
  @@index([schoolId, currency])
}

model AssetMaintenance {
  id              String    @id @default(cuid())
  schoolId        String
  assetId         String
  maintenanceDate DateTime
  description     String
  cost            Decimal?  @db.Decimal(14, 2)
  currency        Currency?
  provider        String?
  nextServiceDate DateTime?
  recordedBy      String
  createdAt       DateTime  @default(now())

  school   School @relation(fields: [schoolId], references: [id])
  asset    Asset  @relation(fields: [assetId], references: [id])
  recorder User   @relation(fields: [recordedBy], references: [id])

  @@index([schoolId])
}

model AssetDisposal {
  id           String         @id @default(cuid())
  schoolId     String
  assetId      String         @unique
  disposalDate DateTime
  reason       String
  method       DisposalMethod
  proceeds     Decimal?       @db.Decimal(14, 2)
  currency     Currency?
  recordedBy   String
  createdAt    DateTime       @default(now())

  school   School  @relation(fields: [schoolId], references: [id])
  asset    Asset   @relation(fields: [assetId], references: [id])
  recorder User    @relation(fields: [recordedBy], references: [id])
  income   Income?

  @@index([schoolId])
}

// ─── Library ─────────────────────────────────────────────────────────────────

model Book {
  id                  String   @id @default(cuid())
  schoolId            String
  isbn                String?
  title               String
  author              String
  subject             String?
  publisher           String?
  year                Int?
  shelfLocation       String?
  coverUrl            String?
  // What a student is charged when they lose a copy (Part 2.7 charge).
  replacementCost     Decimal? @db.Decimal(14, 2)
  replacementCurrency Currency @default(USD)
  // Copy counts are not stored: they are counted from BookCopy (lib/library.ts).

  school School     @relation(fields: [schoolId], references: [id])
  copies BookCopy[]

  @@index([schoolId])
}

model BookCopy {
  id              String        @id @default(cuid())
  schoolId        String
  bookId          String
  accessionNumber String
  condition       CopyCondition @default(NEW)
  status          CopyStatus    @default(AVAILABLE)

  school     School      @relation(fields: [schoolId], references: [id])
  book       Book        @relation(fields: [bookId], references: [id])
  borrowings Borrowing[]

  @@unique([schoolId, accessionNumber])
  @@index([schoolId])
}

// Exactly one of userId (STAFF) and studentId (STUDENT) is set — enforced by the
// check constraints "LibraryMember_exactly_one_person" and "LibraryMember_type_matches"
// (SQL only; keep them when writing migrations).
model LibraryMember {
  id                 String     @id @default(cuid())
  schoolId           String
  memberType         MemberType @default(STAFF)
  userId             String?    @unique
  studentId          String?    @unique
  borrowingSuspended Boolean    @default(false)
  suspensionReason   String?

  school     School      @relation(fields: [schoolId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  student    Student?    @relation(fields: [studentId], references: [id])
  borrowings Borrowing[]

  @@index([schoolId])
}

model Borrowing {
  id                String         @id @default(cuid())
  schoolId          String
  copyId            String
  memberId          String
  checkoutDate      DateTime
  dueDate           DateTime
  returnDate        DateTime?
  conditionOnReturn CopyCondition?
  fineAmount        Decimal        @default(0) @db.Decimal(14, 2)
  fineSettled       Boolean        @default(false)
  createdAt         DateTime       @default(now())

  school School        @relation(fields: [schoolId], references: [id])
  copy   BookCopy      @relation(fields: [copyId], references: [id])
  member LibraryMember @relation(fields: [memberId], references: [id])

  @@index([schoolId])
  @@index([schoolId, copyId])
}

// ─── Finance Settings ────────────────────────────────────────────────────────

// Append-only: a correction is a new row (the database refuses UPDATE and DELETE).
// The rate for a date is the latest row whose effectiveFrom is on or before it.
model ExchangeRate {
  id            String     @id @default(cuid())
  schoolId      String
  school        School     @relation(fields: [schoolId], references: [id])
  usdToZig      Decimal
  effectiveFrom DateTime   @default(now())
  source        RateSource @default(SCHOOL)
  setBy         String
  user          User       @relation(fields: [setBy], references: [id])
  note          String?
  createdAt     DateTime   @default(now())
  payments      Payment[]

  @@index([schoolId])
  @@index([schoolId, createdAt])
  @@index([schoolId, effectiveFrom])
}

// ─── Password reset ──────────────────────────────────────────────────────────
// Sessions are JWTs, so the Auth.js Account / Session / VerificationToken tables are gone.
// A staff password reset is a single-use link valid for 30 minutes; only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  user      User   @relation("ResetTokenUser", fields: [userId], references: [id])
  createdBy User   @relation("ResetTokenCreator", fields: [createdById], references: [id])

  @@index([schoolId])
  @@index([userId])
}

// ─── Dashboard & System ──────────────────────────────────────────────────────

// One row per school. endsAt null = no end date.
model Subscription {
  id           String             @id @default(cuid())
  schoolId     String             @unique
  plan         String             @default("STANDARD")
  status       SubscriptionStatus @default(ACTIVE)
  startsAt     DateTime           @default(now())
  endsAt       DateTime?
  // Most active students the plan allows; null = unlimited.
  studentLimit Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  school School @relation(fields: [schoolId], references: [id])
}

// Module switches. No row = the module is on. "system" cannot be switched off.
model SchoolModule {
  id        String   @id @default(cuid())
  schoolId  String
  module    String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, module])
  @@index([schoolId])
}

// Permission keys granted to a role, per school (lib/access.ts). Empty for now:
// access levels are added later by inserting rows, not by changing pages.
model RolePermission {
  id         String   @id @default(cuid())
  schoolId   String
  role       Role
  permission String
  createdAt  DateTime @default(now())

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, role, permission])
  @@index([schoolId])
}

model Notification {
  id        String    @id @default(cuid())
  schoolId  String
  userId    String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([schoolId])
  @@index([userId, readAt])
}

model CalendarEvent {
  id          String            @id @default(cuid())
  schoolId    String
  title       String
  kind        CalendarEventKind @default(OTHER)
  startDate   DateTime          @db.Date
  endDate     DateTime          @db.Date
  notes       String?
  createdById String
  createdAt   DateTime          @default(now())

  school    School @relation(fields: [schoolId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([schoolId, startDate])
}
