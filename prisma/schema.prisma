  subjectCombinationClasses SubjectCombinationClass[]
  studentSubjects           StudentSubject[]
  teachingGroups            TeachingGroup[]
  teachingGroupStudents     TeachingGroupStudent[]
  teacherAssignments        TeacherAssignment[]
  assignmentSets            AssignmentSet[]
  bellSchedules             BellSchedule[]
  periods                   Period[]
  rooms                     Room[]
  timetables                Timetable[]
  timetableSlots            TimetableSlot[]
  teacherAvailability       TeacherAvailability[]
  coverLessons              CoverLesson[]
  attendanceRegisters       AttendanceRegister[]
  attendanceEntries         AttendanceEntry[]
  messageOutbox             MessageOutbox[]
  syllabusTopics            SyllabusTopic[]
  schemesOfWork             SchemeOfWork[]
  schemeWeeks               SchemeWeek[]
  recordsOfWork             RecordOfWork[]
  lessonPlans               LessonPlan[]
  assessmentTypes           AssessmentType[]
  weightingPlans            WeightingPlan[]
  weightingPlanItems        WeightingPlanItem[]
  weightingPlanItemTypes    WeightingPlanItemType[]
  projectTemplates          ProjectTemplate[]
  projectStages             ProjectStage[]
  rubrics                   Rubric[]
  rubricCriteria            RubricCriterion[]
  rubricLevels              RubricLevel[]
  assessments               Assessment[]
  assessmentTopics          AssessmentTopic[]
  assessmentMarks           AssessmentMark[]
  rubricScores              RubricScore[]
  markEvidence              MarkEvidence[]
  assessmentMarkChanges     AssessmentMarkChange[]
  markSheets                MarkSheet[]
  markSheetEvents           MarkSheetEvent[]
  sheetStudentComments      SheetStudentComment[]
  subjectResults            SubjectResult[]
