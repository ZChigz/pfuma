// ─── Core ────────────────────────────────────────────────────────────────────

model School {
  id                    String         @id @default(cuid())
  name                  String
  location              String?
  // Default capacity for newly created classes.
  maxClassSize          Int            @default(45)
  // Lowest grade that counts as a pass ("C or better" = C), looked up in GradeBoundary.
  passGrade             String         @default("C")
  // O Level classes: rank by average percentage, or by number of passes then average.
  oLevelRanking         RankingMode    @default(AVERAGE)
  // Library: checkout is blocked above this much unpaid fines (in the fine currency),
  // and each kind of member has its own loan limit.
  libraryFineLimit      Decimal        @default(5) @db.Decimal(14, 2)
  studentLoanLimit      Int            @default(2)
  staffLoanLimit        Int            @default(5)
  // Profile shown in the top bar and on documents.
  schoolType            SchoolType     @default(GOVERNMENT)
  phone                 String?
  email                 String?
  address               String?
  motto                 String?
  logoUrl               String?
  defaultCurrency       Currency       @default(USD)
  province              String?
  // ZIMSEC examination centre number.
  zimsecCentreNumber    String?
  // Receipt numbers look like <prefix>-<number>; a null prefix means not chosen yet.
  receiptPrefix         String?
  receiptNextNumber     Int            @default(1)
  // Settings, Finance basics. Formats such as RCP-{YEAR}-{000000}; see lib/numbering.ts.
  currencyUsdEnabled    Boolean        @default(true)
  currencyZigEnabled    Boolean        @default(true)
  receiptFormat         String?
  invoiceFormat         String?
  invoiceNextNumber     Int            @default(1)
  // Settings, Numbering. The code that starts admission numbers, and their format.
  schoolCode            String         @default("STU")
  admissionFormat       String         @default("{SCHOOLCODE}{YEAR}{0000}")
  // Keeps the dashboard setup checklist visible after every step is done.
  setupChecklistPinned  Boolean        @default(false)
  // School profile (Settings, tab 1). The old "location" and "address" columns stay until the
  // contract migration; district and physicalAddress replace them and were filled from them.
  responsibleAuthority  String?
  boarding              SchoolBoarding @default(DAY)
  studentGender         SchoolGender   @default(CO_ED)
  // ZIMSEC is always on; Cambridge is optional.
  offersCambridge       Boolean        @default(false)
  emisNumber            String?
  district              String?
  physicalAddress       String?
  postalAddress         String?
  website               String?
  headName              String?
  headSignatureUrl      String?
  // Document types every student file must hold (DocumentType values), chosen in Settings.
  requiredDocumentTypes String[]       @default([])
  // Letter reference numbers count up from here (ADM-2026-00012).
  letterNextNumber      Int            @default(1)
  // Subscription (managed from the Pfuma console, shown on Settings, Subscription).
  status                SchoolStatus   @default(ACTIVE)
  planId                String?
  renewalDate           DateTime?      @db.Date
  studentLimit          Int?
  suspendedReason       String?
  // Access control (Settings, Roles). A school with one finance person lets the Owner act as the second person; teaching-staff leave may be
  // approved by the Deputy when the Head turns delegation on; last term's records stay readable to a teacher for this many days.
  singlePersonFinance   Boolean        @default(false)
  deputyLeaveDelegation Boolean        @default(false)
  previousTermReadDays  Int            @default(30)
  createdAt             DateTime       @default(now())
  // Legacy column "currentTerm" still exists in the database until the
  // contract migration; the current term is now the OPEN AcademicTerm.

  levels        Level[]
  academicYears AcademicYear[]
  academicTerms AcademicTerm[]
  enrollments   Enrollment[]
  guardians     Guardian[]

  users                     User[]
  students                  Student[]
  feeStructures             FeeStructure[]
  charges                   Charge[]
  payments                  Payment[]
  expenses                  Expense[]
  expenseRequests           ExpenseRequest[]
  auditLogs                 AuditLog[]
  subjects                  Subject[]
